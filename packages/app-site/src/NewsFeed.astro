---
import "./news-feed.css";

export type NewsPost = {
  id: string;
  date: string;
  datetime: string;
  badge: string;
  badgeTone?: "default" | "note" | "column";
  title: string;
  summary: string;
  body: string[];
};

const { posts, lang = "en", heading = "", basePath } = Astro.props as {
  posts: NewsPost[];
  lang?: "ja" | "en";
  heading?: string;
  /**
   * Base path each post links to — the post's id is appended. Every site keeps
   * its news at the same two addresses, so this defaults to them rather than
   * staying required: a caller that forgot it used to render `undefined/<id>`
   * links, silently, on a page that still looked finished.
   */
  basePath?: string;
};

const ja = lang === "ja";
const postBasePath = basePath ?? (ja ? "/ja/news" : "/news");
const count = (kind: "all" | "updates" | "column") =>
  kind === "all"
    ? posts.length
    : posts.filter((post) => (post.badgeTone === "column" ? "column" : "updates") === kind).length;
const filters = [
  { key: "all", label: ja ? "すべて" : "All" },
  { key: "updates", label: ja ? "お知らせ" : "Updates" },
  { key: "column", label: ja ? "コラム" : "Columns" },
] as const;
---

<section class="app-news" data-app-news aria-label={heading || (ja ? "ニュース" : "News")}>
  {heading && <h2 class="app-news-heading">{heading}</h2>}

  <nav class="app-news-tabs" aria-label={ja ? "記事の種類" : "Post type"}>
    {filters.map((filter, index) => (
      <button
        type="button"
        data-news-filter={filter.key}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        <span>{filter.label}</span><small>{count(filter.key)}</small>
      </button>
    ))}
  </nav>

  <ol class="app-news-timeline" data-news-grid>
    {posts.map((post, index) => {
      const kind = post.badgeTone === "column" ? "column" : "updates";
      const [year, month, day] = post.datetime.split("-");
      return (
        <li class:list={["app-news-item", index === 0 && "is-latest"]} data-news-kind={kind} data-reveal style={`--reveal-i:${Math.min(index, 4)}`}>
          <div class="app-news-rail" aria-hidden="true">
            <span class="app-news-dot"></span>
            <span class="app-news-stamp"><b>{month}.{day}</b><small>{year}</small></span>
          </div>
          <a class="app-news-card" href={`${postBasePath}/${post.id}`}>
            <span class="app-news-meta">
              <span class:list={["app-news-badge", post.badgeTone && `is-${post.badgeTone}`]}>{post.badge}</span>
              <time datetime={post.datetime}>{post.date}</time>
            </span>
            <span class="app-news-title">{post.title}</span>
            <span class="app-news-summary">{post.summary}</span>
            <span class="app-news-read">
              <span>{ja ? "読む" : "Read on"}</span>
              <i aria-hidden="true">↗</i>
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  <p class="app-news-empty" data-news-empty hidden>{ja ? "この種類の記事はまだありません。" : "Nothing of this kind yet."}</p>
</section>

<script is:inline>
  (() => {
    const bindNews = () => {
      document.querySelectorAll("[data-app-news]").forEach((root) => {
        if (root.dataset.bound === "1") return;
        root.dataset.bound = "1";
        const items = Array.from(root.querySelectorAll("[data-news-kind]"));
        const empty = root.querySelector("[data-news-empty]");
        root.querySelector(".app-news-tabs")?.addEventListener("click", (event) => {
          const button = event.target.closest("button[data-news-filter]");
          if (!button) return;
          const filter = button.dataset.newsFilter;
          root.querySelectorAll("button[data-news-filter]").forEach((item) => {
            item.setAttribute("aria-pressed", String(item === button));
          });
          let shown = 0;
          items.forEach((item) => {
            const match = filter === "all" || item.dataset.newsKind === filter;
            item.hidden = !match;
            if (match) shown += 1;
          });
          if (empty) empty.hidden = shown !== 0;
        });
      });
    };
    document.addEventListener("astro:page-load", bindNews);
    bindNews();
  })();
</script>
