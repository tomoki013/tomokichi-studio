---
import { ClientRouter } from "astro:transitions";
import AppSiteShellClient from "./AppSiteShellClient.astro";
import {
  type AppSiteLocaleLink,
  type AppSiteShellLabels,
  defaultShellLabels,
  localeMeta,
} from "./i18n";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { canonicalUrl } from "./seo";
import "./app-site-shell.css";

type NavItem = { slug: string; label: string; href: string };
type FooterLink = { label: string; href: string; external?: boolean };
type FooterColumn = { title: string; links: FooterLink[] };

const {
  lang,
  title,
  description,
  page = "",
  brand,
  tagline,
  siteUrl,
  homeHref,
  jaPageHref,
  enPageHref,
  localeLinks = [] as AppSiteLocaleLink[],
  defaultLocale = "en",
  shellLabels,
  nav,
  footerColumns,
  appStoreLabel,
  appStoreHref = "#download",
  appStoreComingSoon = false,
  menuLabel,
  menuCloseLabel,
  logoMark = "◎",
  logoImage = "",
  favicon = "",
  themeColor = "#f8fbfa",
  ogImage = "",
  pageClass = "",
  jsonLd = "",
  noindex = false,
  mobileFooterLinks = [] as FooterLink[],
  clientRouter = true,
} = Astro.props as {
  lang: string;
  title: string;
  description: string;
  page?: string;
  brand: string;
  tagline: string;
  siteUrl: string;
  homeHref: string;
  /** Legacy EN/JA props. Prefer localeLinks for new and migrated sites. */
  jaPageHref?: string;
  enPageHref?: string;
  localeLinks?: AppSiteLocaleLink[];
  defaultLocale?: string;
  shellLabels?: Partial<AppSiteShellLabels>;
  nav: NavItem[];
  footerColumns: FooterColumn[];
  appStoreLabel: string;
  appStoreHref?: string;
  appStoreComingSoon?: boolean;
  menuLabel: string;
  menuCloseLabel?: string;
  logoMark?: string;
  logoImage?: string;
  favicon?: string;
  themeColor?: string;
  ogImage?: string;
  pageClass?: string;
  jsonLd?: string;
  /** Pages that exist for people but have no place in search results. */
  noindex?: boolean;
  mobileFooterLinks?: FooterLink[];
  clientRouter?: boolean;
};

const legacyLocaleLinks: AppSiteLocaleLink[] = [
  ...(enPageHref ? [{ ...localeMeta("en"), href: enPageHref }] : []),
  ...(jaPageHref ? [{ ...localeMeta("ja"), href: jaPageHref }] : []),
];
const resolvedLocaleLinks = localeLinks.length > 0 ? localeLinks : legacyLocaleLinks;
const currentLocale = resolvedLocaleLinks.find((locale) => locale.code === lang) ?? localeMeta(lang);
const currentHref = resolvedLocaleLinks.find((locale) => locale.code === lang)?.href ?? homeHref;
const defaultHref = resolvedLocaleLinks.find((locale) => locale.code === defaultLocale)?.href ?? currentHref;
const labels: AppSiteShellLabels = {
  ...(defaultShellLabels[lang] ?? defaultShellLabels.en),
  ...shellLabels,
};
const absolutePageUrl = canonicalUrl(siteUrl, currentHref);
const absoluteOgImage = ogImage ? new URL(ogImage, siteUrl).toString() : "";
const mobileNavId = `app-site-mobile-nav-${lang}`;
const closeLabel = menuCloseLabel ?? (lang === "ja" ? "メニューを閉じる" : "Close menu");
const storeIsLink = Boolean(appStoreHref) && !appStoreComingSoon;
const resolvedMobileFooter =
  mobileFooterLinks.length > 0
    ? mobileFooterLinks
    : footerColumns.flatMap((column) => column.links).slice(0, 6);
const iconHref = favicon || logoImage;
const ogType = absoluteOgImage.endsWith(".jpg") || absoluteOgImage.endsWith(".jpeg")
  ? "image/jpeg"
  : absoluteOgImage.endsWith(".webp")
    ? "image/webp"
    : "image/png";
---

<!doctype html>
<html lang={lang} dir={currentLocale.dir ?? "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    {!noindex && <link rel="canonical" href={absolutePageUrl} />}
    {!noindex && resolvedLocaleLinks.map((locale) => (
      <link rel="alternate" hreflang={locale.code} href={canonicalUrl(siteUrl, locale.href)} />
    ))}
    {!noindex && resolvedLocaleLinks.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={canonicalUrl(siteUrl, defaultHref)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={`${title} — ${brand}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolutePageUrl} />
    {currentLocale.ogLocale && <meta property="og:locale" content={currentLocale.ogLocale} />}
    {resolvedLocaleLinks
      .filter((locale) => locale.code !== lang && locale.ogLocale)
      .map((locale) => <meta property="og:locale:alternate" content={locale.ogLocale} />)}
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:type" content={ogType} />}
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} — ${brand}`} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {iconHref && <link rel="icon" type="image/png" href={iconHref} />}
    <title>{title} — {brand}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {clientRouter && <ClientRouter />}
  </head>
  <body>
    <div class:list={["app-site-page", pageClass]}>
      <a class="app-site-skip" href="#main">{labels.skipToContent}</a>
      <header class="app-site-header" data-app-header>
        <div class="app-site-header-inner">
          <a class="app-site-logo" href={homeHref}>
            {logoImage ? (
              <img class="app-site-logo-image" src={logoImage} alt="" width="58" height="58" decoding="async" fetchpriority="high" />
            ) : (
              <span class="app-site-logo-mark">{logoMark}</span>
            )}
            {brand}
          </a>
          <nav class="app-site-primary-nav" aria-label={labels.mainNavigation}>
            <a class:list={{ active: !page }} href={homeHref} aria-current={!page ? "page" : undefined} data-astro-prefetch>
              {labels.home}
            </a>
            {nav.map((item) => (
              <a class:list={{ active: page === item.slug }} href={item.href} aria-current={page === item.slug ? "page" : undefined} data-astro-prefetch>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="app-site-actions">
            {resolvedLocaleLinks.length > 1 && (
              <LocaleSwitcher lang={lang} locales={resolvedLocaleLinks} label={labels.language} placement="header" />
            )}
            {storeIsLink ? (
              <a class="app-site-store-link app-site-desktop-only" href={appStoreHref}>{appStoreLabel}</a>
            ) : (
              <span class="app-site-store-link app-site-store-soon app-site-desktop-only" aria-disabled="true">{appStoreLabel}</span>
            )}
            <button
              class="app-site-mobile-menu"
              type="button"
              aria-label={menuLabel}
              aria-expanded="false"
              aria-controls={mobileNavId}
              data-menu-open-label={menuLabel}
              data-menu-close-label={closeLabel}
            >
              <span class="app-site-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
          </div>
        </div>
      </header>

      <div class="app-site-mobile-scrim" data-mobile-scrim hidden></div>
      <nav class="app-site-mobile-nav" id={mobileNavId} aria-label={menuLabel} hidden data-mobile-nav>
        <div class="app-site-mobile-nav-panel">
          <div class="app-site-mobile-nav-top">
            <p class="app-site-mobile-nav-brand">{brand}</p>
            <button class="app-site-mobile-close" type="button" aria-label={closeLabel} data-mobile-close>
              <span class="app-site-menu-icon is-open" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
          </div>
          <div class="app-site-mobile-nav-links">
            <a href={homeHref} aria-current={!page ? "page" : undefined} style="--item-i:0" data-astro-prefetch>{labels.home}</a>
            {nav.map((item, index) => (
              <a href={item.href} aria-current={page === item.slug ? "page" : undefined} style={`--item-i:${index + 1}`} data-astro-prefetch>
                {item.label}
              </a>
            ))}
          </div>
          <div class="app-site-mobile-nav-meta">
            {resolvedLocaleLinks.length > 1 && (
              <LocaleSwitcher lang={lang} locales={resolvedLocaleLinks} label={labels.language} placement="mobile" />
            )}
            {storeIsLink ? (
              <a class="app-site-mobile-store" href={appStoreHref}>{appStoreLabel}</a>
            ) : (
              <span class="app-site-mobile-store app-site-store-soon" aria-disabled="true">{appStoreLabel}</span>
            )}
            <div class="app-site-mobile-footer-links">
              {resolvedMobileFooter.map((link) => (
                <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>

      <main id="main" transition:animate={clientRouter ? "fade" : undefined}><slot /></main>
      <footer class="app-site-footer">
        <div class="app-site-footer-brand">
          <a class="app-site-logo" href={homeHref}>
            {logoImage ? (
              <img class="app-site-logo-image" src={logoImage} alt="" width="58" height="58" decoding="async" loading="lazy" />
            ) : (
              <span class="app-site-logo-mark">{logoMark}</span>
            )}
            {brand}
          </a>
          <p>{tagline}</p>
          {resolvedLocaleLinks.length > 1 && (
            <LocaleSwitcher lang={lang} locales={resolvedLocaleLinks} label={labels.language} placement="footer" />
          )}
        </div>
        <div class="app-site-footer-columns">
          {footerColumns.map((column) => (
            <nav aria-label={column.title}>
              <h2>{column.title}</h2>
              {column.links.map((link) => (
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  data-astro-prefetch={!link.external ? true : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
          ))}
        </div>
        <div class="app-site-footer-base"><small>© 2026 {brand}</small><p>Made with ♡ by Tomokichi</p></div>
      </footer>
    </div>
    <AppSiteShellClient />
  </body>
</html>
