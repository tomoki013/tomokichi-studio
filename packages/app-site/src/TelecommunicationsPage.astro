---
import type { TelecomSection } from "./telecommunications";
import { TELECOM, telecommunicationsRows } from "./telecommunications";
import { supportUrl } from "./urls";

const {
  lang,
  appName,
  appSlug,
  summary,
  sections = [],
  lastUpdated = ["2026年9月8日", "September 8, 2026"],
} = Astro.props as {
  lang: "ja" | "en";
  appName: string;
  appSlug: string;
  /** What the app actually transmits, Japanese then English. */
  summary?: [string, string];
  /** App-specific important-matters sections, Japanese then English. */
  sections?: TelecomSection[];
  /** Effective date of this disclosure, Japanese then English. */
  lastUpdated?: [string, string];
};
const ja = lang === "ja";
const rows = telecommunicationsRows(lang, appName);
const contactHref = supportUrl(appSlug, lang);
---

<section class="telecom-page">
  <header class="telecom-intro" data-reveal>
    <p class="telecom-eyebrow">LEGAL</p>
    <h1>{ja ? "電気通信事業法に基づく表記" : "Telecommunications Business Act Disclosure"}</h1>
    <p>
      {ja
        ? `${appName}は、電気通信事業法第16条に基づく届出を行っています。事業者情報と、サービスで行う通信の概要を掲載しています。`
        : `A notification for ${appName} has been filed under Article 16 of Japan's Telecommunications Business Act. This page also explains the service's communications and conditions.`}
    </p>
  </header>

  <dl class="telecom-list" data-reveal>
    {rows.map((row) => (
      <div>
        <dt>{row.term}</dt>
        <dd>
          {row.kind === "telephone" ? (
            <a class="telecom-action" href={TELECOM.telephoneHref}>{row.body}</a>
          ) : row.kind === "contact" ? (
            <span class="telecom-actions">
              <a class="telecom-action" href={`mailto:${TELECOM.email}`}>{row.body}</a>
              <a class="telecom-action is-primary" href={contactHref}>
                {ja ? "お問い合わせフォームを開く" : "Open the support form"}
                <span aria-hidden="true">→</span>
              </a>
            </span>
          ) : (
            row.body
          )}
        </dd>
      </div>
    ))}
  </dl>

  {summary && (
    <div class="telecom-summary" data-reveal>
      <p class="telecom-summary-label">{ja ? "通信機能の概要" : "Communication summary"}</p>
      <p>{summary[ja ? 0 : 1]}</p>
    </div>
  )}

  {sections.length > 0 && (
    <div class="telecom-sections" data-reveal>
      {sections.map((section) => (
        <article class="telecom-section">
          <h2>{section.heading[ja ? 0 : 1]}</h2>
          <p>{section.body[ja ? 0 : 1]}</p>
          {section.links && section.links.length > 0 && (
            <div class="telecom-section-links">
              {section.links.map((link) => (
                <a class="telecom-section-link" href={link.href[ja ? 0 : 1]}>{link.label[ja ? 0 : 1]} <span aria-hidden="true">→</span></a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  )}

  <p class="telecom-updated">{ja ? `最終更新日：${lastUpdated[0]}` : `Last updated: ${lastUpdated[1]}`}</p>
</section>

<style>
  .telecom-page { width: min(760px, calc(100% - 40px)); margin: 0 auto; padding: clamp(84px, 10vw, 128px) 0 clamp(80px, 10vw, 120px); }
  .telecom-intro { margin-bottom: clamp(36px, 6vw, 58px); }
  .telecom-eyebrow { margin: 0 0 14px; font-size: 10px; font-weight: 700; letter-spacing: .22em; opacity: .52; }
  .telecom-intro h1 { margin: 0; font-size: clamp(30px, 5vw, 48px); font-weight: 500; line-height: 1.32; letter-spacing: -.035em; }
  .telecom-intro > p:last-child { margin: 20px 0 0; line-height: 1.9; opacity: .68; }
  .telecom-list { margin: 0; border-top: 1px solid currentColor; }
  .telecom-list > div { display: grid; grid-template-columns: minmax(150px, 28%) 1fr; gap: 24px; padding: 23px 4px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
  .telecom-list dt { font-size: 13px; font-weight: 650; line-height: 1.8; }
  .telecom-list dd { margin: 0; font-size: 13px; line-height: 1.9; opacity: .78; }
  .telecom-list a { color: inherit; text-underline-offset: 4px; }
  .telecom-summary { margin: 26px 0 0; padding: 18px 20px; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: 16px; font-size: 13px; line-height: 1.9; background: color-mix(in srgb, currentColor 4%, transparent); }
  .telecom-summary p { margin: 0; }
  .telecom-summary p + p { margin-top: 7px; opacity: .72; }
  .telecom-summary-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; opacity: .58; }

  .telecom-sections { margin-top: 18px; border-top: 1px solid currentColor; }
  .telecom-section { padding: 27px 4px 29px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
  .telecom-section h2 { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.5; letter-spacing: -.015em; }
  .telecom-section p { margin: 11px 0 0; font-size: 13px; line-height: 2; white-space: pre-line; opacity: .76; }
  .telecom-section-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
  .telecom-section-link { color: inherit; font-size: 12.5px; line-height: 1.5; text-underline-offset: 4px; }
  .telecom-section-link span { display: inline-block; transition: transform .22s ease; }
  .telecom-section-link:hover span, .telecom-section-link:focus-visible span { transform: translateX(3px); }
  .telecom-updated { margin: 24px 0 0; font-size: 11px; opacity: .52; }

  .telecom-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .telecom-action {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 15px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
    font-size: 12.5px; line-height: 1.5; text-decoration: none; white-space: nowrap;
    transition: background-color .22s ease, border-color .22s ease, transform .22s ease;
  }
  .telecom-action:hover,
  .telecom-action:focus-visible {
    background: color-mix(in srgb, currentColor 9%, transparent);
    border-color: color-mix(in srgb, currentColor 46%, transparent);
    transform: translateY(-1px);
  }
  .telecom-action.is-primary { border-color: color-mix(in srgb, currentColor 52%, transparent); font-weight: 600; }
  .telecom-action span { transition: transform .22s ease; }
  .telecom-action:hover span { transform: translateX(3px); }

  @media (max-width: 600px) {
    .telecom-page { width: min(100% - 32px, 760px); padding-top: 72px; }
    .telecom-list > div { grid-template-columns: 1fr; gap: 7px; padding: 19px 2px; }
    .telecom-list dt, .telecom-list dd { font-size: 12.5px; }
    .telecom-section { padding-left: 2px; padding-right: 2px; }
    .telecom-section h2 { font-size: 16px; }
    .telecom-action { white-space: normal; }
  }
</style>
