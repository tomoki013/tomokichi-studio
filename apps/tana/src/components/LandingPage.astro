---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import PhoneFrame from "@tomokichi/app-site/PhoneFrame.astro";
import { appApplicationGraph, jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import { appSiteUrl } from "@tomokichi/app-site/urls";
import AppShell from "./AppShell.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";

const features = ja
  ? [
      { mark: "書", title: "本棚を整える", body: "本とシリーズを登録し、評価・タグ・メモで自分の棚をつくります。" },
      { mark: "頁", title: "進捗を残す", body: "ページ単位でも巻単位でも。いまどこまで読んだかが分かります。" },
      { mark: "記", title: "記録と連続", body: "読書ログとストリークで、静かな習慣が少しずつ見えてきます。" },
      { mark: "集", title: "コレクション", body: "テーマや気分ごとに本を集め、棚とは別の眺めをつくれます。" },
      { mark: "冊", title: "所持と欠巻", body: "紙・電子・両方・読むだけ・未所持。欠けている巻にも気づけます。" },
      { mark: "機", title: "端末の中に", body: "アカウント不要。SwiftDataで端末内保存。JSONバックアップにも対応。" },
    ]
  : [
      { mark: "Shelf", title: "Organise your shelf", body: "Register books and series, then add ratings, tags, and notes." },
      { mark: "Page", title: "Track progress", body: "By page or by volume—always know where you left off." },
      { mark: "Log", title: "Logs and streaks", body: "Reading logs and streaks make a quiet habit visible." },
      { mark: "Set", title: "Collections", body: "Group books by theme or mood, beyond the main shelf." },
      { mark: "Own", title: "Ownership & gaps", body: "Paper, digital, both, read-only, or unowned—and spot missing volumes." },
      { mark: "Local", title: "On your device", body: "No account. SwiftData on-device. JSON backup included." },
    ];

const tabs = ja
  ? [
      { name: "本棚", body: "持っている本とシリーズを眺める場所。" },
      { name: "探す", body: "登録や検索の入り口。" },
      { name: "記録", body: "読書ログと日々の積み重ね。" },
      { name: "コレクション", body: "テーマごとに本を集める。" },
      { name: "マイページ", body: "統計、設定、自分の読書の様子。" },
    ]
  : [
      { name: "Shelf", body: "Browse the books and series you keep." },
      { name: "Discover", body: "Where registration and search begin." },
      { name: "Log", body: "Reading logs and daily progress." },
      { name: "Collections", body: "Gather books by theme." },
      { name: "My Page", body: "Stats, settings, and your reading rhythm." },
    ];

const description = ja
  ? "Tanaは、本棚にある本を静かに整理するローカルファーストの読書管理アプリです。進捗・記録・コレクション・所持管理まで。現在App Store公開準備中。"
  : "Tana is a local-first reading and bookshelf app for quietly organising the books you own—progress, logs, collections, and ownership. Currently preparing for the App Store.";

const jsonLd = serializeJsonLd(
  appApplicationGraph({
    siteUrl: appSiteUrl("tana"),
    name: "Tana",
    description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS 17.0 or later",
    path: base || "/",
  }),
);
---

<AppShell
  lang={lang}
  title={ja ? "本棚にある本を、静かに整理する。" : "Quietly organise the books on your shelf."}
  description={description}
  jsonLd={jsonLd}
>
  <section class="tana-hero">
    <div class="hero-wood" aria-hidden="true">
      <span class="hero-glow hero-glow-a"></span>
      <span class="hero-glow hero-glow-b"></span>
      <div class="hero-shelf-row">
        <i class="spine spine-a"></i>
        <i class="spine spine-b"></i>
        <i class="spine spine-c"></i>
        <i class="spine spine-d"></i>
        <i class="spine spine-e"></i>
        <i class="spine spine-f"></i>
        <i class="spine spine-g"></i>
      </div>
    </div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">READING · SHELF</p>
        <h1>{ja ? <>本棚にある本を、<br />静かに整理する。</> : <>Quietly organise<br />the books on your shelf.</>}</h1>
        <p class="hero-lead">{ja ? "紙の香りと、木の棚のようなアプリ。" : "Like cream paper and a warm wooden shelf."}</p>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-body">
          {ja
            ? "所持・進捗・記録・欠巻。本棚の前に立つように、手元で静かに整える。"
            : "Ownership, progress, logs, missing volumes—quiet order, as if standing before your shelf."}
        </p>
        <div class="reading-mark" aria-hidden="true">
          <span class="reading-page">{ja ? "p.142" : "p.142"}</span>
          <span class="reading-bar"><i></i></span>
          <span class="reading-label">{ja ? "いま読んでいる" : "reading now"}</span>
        </div>
        <div class="hero-actions">
          <span class="store-button store-soon" aria-disabled="true">
            <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
            {storeLabel}
          </span>
          <a class="secondary-button" href={`${base}/features`}>{ja ? "詳しく見る" : "Learn more"}</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <PhoneFrame size="lg" tone="graphite" glare={false} class="tana-phone-frame">
          <div class="concept-phone-screen">
            <p class="concept-phone-label">{ja ? "本棚" : "Shelf"}</p>
            <div class="concept-book-grid">
              <span></span><span></span><span></span>
              <span></span><span></span><span></span>
            </div>
            <div class="concept-tab-bar">
              <i class="is-active"></i><i></i><i></i><i></i><i></i>
            </div>
          </div>
        </PhoneFrame>
        <p class="concept-caption">{ja ? "画面イメージ（コンセプト）" : "Concept visual — not a real screenshot"}</p>
      </div>
    </div>

    <AppHeroChrome
      lang={lang}
      date="2026-08-08"
      news={ja ? "Tana公式ブランドサイトを公開しました" : "The official Tana brand site is now live"}
      newsHref={`${base}/news`}
    />
  </section>

  <section class="feature-section section-pad" id="features">
    <header class="section-heading" data-reveal>
      <h2>{ja ? "Tanaでできること" : "What Tana does"}</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </header>
    <div class="feature-grid">
      {features.map(({ mark, title, body }) => (
        <article data-reveal>
          <span class="feature-mark" aria-hidden="true">{mark}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="story-section section-pad" id="tabs">
    <div class="story-copy" data-reveal>
      <h2>{ja ? <>五つのタブで、<br />読書の輪郭を。</> : <>Five tabs for<br />the shape of reading.</>}</h2>
      <span class="story-rule" aria-hidden="true"></span>
      <p>
        {ja
          ? "本棚・探す・記録・コレクション・マイページ。持っている本から日々の記録まで、必要な場所がすぐそこにある構成です。"
          : "Shelf, Discover, Log, Collections, and My Page—so owned books and daily logs each have a quiet place."}
      </p>
    </div>
    <div class="tab-cards" data-reveal>
      {tabs.map((tab) => (
        <article class="tab-card">
          <h3>{tab.name}</h3>
          <p>{tab.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="story-section story-reverse section-pad">
    <div class="story-visual story-shelf" data-reveal aria-hidden="true">
      <div class="shelf-board">
        <i class="spine spine-a"></i>
        <i class="spine spine-b"></i>
        <i class="spine spine-c"></i>
        <i class="spine spine-d"></i>
        <i class="spine spine-e"></i>
        <i class="spine spine-f"></i>
      </div>
      <div class="shelf-board">
        <i class="spine spine-g"></i>
        <i class="spine spine-c"></i>
        <i class="spine spine-a"></i>
        <i class="spine spine-e"></i>
        <i class="spine spine-b"></i>
      </div>
    </div>
    <div class="story-copy" data-reveal>
      <h2>{ja ? "同じ巻を、二度買わないために。" : "So you don’t buy the same volume twice."}</h2>
      <span class="story-rule" aria-hidden="true"></span>
      <p>
        {ja
          ? "所持状態と欠巻の検知、一括での巻登録。本棚の前に立たなくても、手元の棚が分かります。"
          : "Ownership states, missing-volume detection, and bulk volume entry—know your shelf without standing in front of it."}
      </p>
    </div>
  </section>

  <section class="pricing-teaser section-pad" data-reveal>
    <header class="section-heading">
      <h2>{ja ? "基本機能は、すべて無料です。" : "Every core feature is free."}</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </header>
    <p class="pricing-teaser-body">
      {ja
        ? "無料版にはバナー広告と、操作後のインタースティシャルが表示される場合があります。一度きりの「広告を永久に削除」（¥400・税込予定）で広告を非表示にできます。サブスクリプションではありません。"
        : "The free version may show banner ads and occasional interstitials. A one-time “Remove ads permanently” purchase (intended ¥400, tax included) removes ads. It is not a subscription."}
    </p>
    <a class="text-link" href={`${base}/pricing`}>{ja ? "料金について詳しく" : "About pricing"} →</a>
  </section>

  <section class="download-section" id="download" data-reveal>
    <h2>{ja ? "本棚にある本を、静かに整理する。" : "Quietly organise the books on your shelf."}</h2>
    <p class="download-note">
      {ja
        ? "iPhone・iOS 17以降に対応。11言語。現在はApp Store公開準備中です。"
        : "Requires an iPhone with iOS 17 or later. 11 languages. Currently preparing for the App Store."}
    </p>
    <span class="store-button store-soon" aria-disabled="true">
      <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
      {storeLabel}
    </span>
  </section>
</AppShell>
