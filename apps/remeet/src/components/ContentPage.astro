---
import AppSimpleSteps from "@tomokichi/app-site/AppSimpleSteps.astro";
import AppStory, { type StoryStep } from "@tomokichi/app-site/AppStory.astro";
import AppUpdatesPage from "@tomokichi/app-site/AppUpdatesPage.astro";
import NewsFeed from "@tomokichi/app-site/NewsFeed.astro";
import {
  faqs as faqList,
  features as featureList,
  guides as guideList,
  icons,
  type Locale,
  type Page,
  pageDescriptions,
  pick,
  privacySections,
  subtitleMap,
  termsSections,
  titleMap,
} from "../lib/content";
import { supportHref } from "../lib/links";
import { getNewsPosts } from "../lib/news";
import AppScreen from "./AppScreen.astro";
import AppShell from "./AppShell.astro";
import StoryVisual from "./StoryVisual.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const title = pick(ja, titleMap[page]);
const subtitlePair = subtitleMap[page];
const descriptionPair = pageDescriptions[page];
const subtitle = subtitlePair ? pick(ja, subtitlePair) : undefined;
const description = descriptionPair ? pick(ja, descriptionPair) : undefined;
const features = featureList(ja);
const guides = guideList(ja);
const faqs = faqList(ja);
const legalSections = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];
const legalDate = ja
  ? "制定日：2026年7月24日／最終更新日：2026年8月29日"
  : "Effective date: July 24, 2026 / Last updated: August 29, 2026";

const faqCategories = ja
  ? [["all", "すべて"], ["start", "はじめての方へ"], ["feature", "機能について"], ["data", "データについて"], ["other", "その他"]]
  : [["all", "All"], ["start", "Getting started"], ["feature", "Features"], ["data", "Your data"], ["other", "Other"]];

const planIncludes = ja
  ? [
      "再会予定の作成（個人利用の数に制限はありません）",
      "待っている間の記録（写真・メモ）",
      "会ったらやりたいことリスト",
      "再会のアルバムと振り返り",
      "ホーム画面・ロック画面のウィジェット",
      "再会のリマインダー通知",
      "6言語対応",
      "アカウント登録不要",
      "端末内保存",
      "最初の再会を1人のパートナーと無料で共有",
    ]
  : [
      "Create reunion plans (no limit for personal use)",
      "Waiting memories (photos and notes)",
      "List of things you want to do together",
      "Reunion albums and reflections",
      "Home Screen and Lock Screen widgets",
      "Reunion reminder notifications",
      "Six languages",
      "No account required",
      "On-device storage",
      "Share your first reunion with one partner for free",
    ];

const screenshots = (
  ja
    ? [
        ["home", "ホーム"],
        ["memories", "待っている間の記録"],
        ["wishes", "やりたいこと"],
        ["album", "アルバム"],
        ["settings", "設定"],
      ]
    : [
        ["home", "Home"],
        ["memories", "Memories"],
        ["wishes", "Wish list"],
        ["album", "Album"],
        ["settings", "Settings"],
      ]
) as ["home" | "memories" | "wishes" | "album" | "settings", string][];

/*
 * Features and How-to lead with the shared scroll story. Only the beats that a
 * real screen can carry become story steps; the rest of the feature list stays
 * a compact grid underneath, so the page does not become thirty screens tall.
 */
const featureBeats: StoryStep[] = (
  ja
    ? [
        ["再会までのカウントダウン", "再会の日までを、日数と進捗で見守ります。少しずつ近づいていく感覚が、待つ時間を支えます。", "home"],
        ["二つの場所をつなぐルート", "ふたりの場所をつなぐルートイラストで、離れている距離をやさしく表現します。正確な地図やリアルタイムの航路ではありません。", "home"],
        ["待っている間の記録", "写真とメモで、離れている日々を自分の記録として残せます。1件につき写真は1枚です。", "memories"],
        ["会ったらやりたいことリスト", "一緒にしたいことをリストに残せます。共有した再会では、招待したパートナーと一緒に編集できます。", "wishes"],
        ["再会の日を、アルバムに", "会えた日の写真と振り返りを残し、完了した再会はアルバムとして見返せます。", "album"],
        ["通知も言語も、設定で選ぶ", "1週間前・前日・当日の朝・再会時刻の通知を個別に切り替えられます。節目や記念日、共有相手からのリアクションも届くことがあります。日本語を含む6言語に対応しています。", "settings"],
      ]
    : [
        ["A countdown to the reunion", "Watch the days and progress until you meet again. Feeling it draw closer carries the waiting.", "home"],
        ["A route between two places", "A gentle route illustration connects both places and softens the distance. It is not a live map or real-time flight path.", "home"],
        ["Memories while apart", "Keep photos and notes from the days in between as your own record. One photo per entry.", "memories"],
        ["Things to do together", "List what you want to do when you meet. On a shared reunion, the invited partner can edit it with you.", "wishes"],
        ["The day itself, in an album", "Save a photo and reflection from the day you meet, then revisit completed reunions in albums.", "album"],
        ["Notifications and language, your way", "Toggle one week before, the day before, the morning of, and reunion time independently. Milestones, anniversaries, and partner reactions may also arrive. Available in six languages.", "settings"],
      ]
).map(([title, body, screen], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  visual: { lang, screen },
}));

const howBeats: StoryStep[] = (
  ja
    ? [
        ["再会予定を作る", "再会の日付と、ふたりがいる場所を設定します。旅行や帰省など、複数の予定を並行して持てます。", "home", "独自アカウントは不要です。作成した予定はすぐにホームに表示されます。"],
        ["待っている日々を記録する", "写真とメモで、離れている時間を残します。毎日でなくてかまいません。", "memories", "記録は端末内に保存され、iCloudにサインインしていれば同じApple Accountの端末へ同期されることがあります。"],
        ["会ったらやりたいことを残す", "再会の日にしたいことを、ひとつずつリストに。共有した再会なら、相手と一緒に書き足せます。", "wishes", "共有した再会だけがAppleのiCloudを通じて同期されます。"],
        ["再会の日を、アルバムに残す", "会えた日の写真と振り返りをアルバムへ。予定が変わったときは日時を変更できます。", "album", "同じ相手の再会は、あとからまとめられます。"],
        ["通知とウィジェットを整える", "設定から通知の種類を選び、ホーム画面やロック画面にウィジェットを置きます。", "settings", "ウィジェットはアプリを開かずに残り日数を確認できます。"],
      ]
    : [
        ["Create a reunion", "Set the date and where each of you will be. Trips and visits can run side by side.", "home", "No proprietary account is needed. A new plan appears on Home right away."],
        ["Record the waiting days", "Keep photos and notes from the time apart. It does not have to be every day.", "memories", "Records stay on your device, and may sync to other devices on the same Apple Account if you use iCloud."],
        ["Save things to do together", "List what you want to do when you meet. On a shared reunion you can add to it together.", "wishes", "Only a shared reunion syncs, through Apple iCloud."],
        ["Keep the day in an album", "Save a photo and reflection from the day you meet, or change the date if plans move.", "album", "Reunions with the same person can be grouped later."],
        ["Set up notices and widgets", "Choose which notifications you want in Settings, then place a widget on your Home or Lock Screen.", "settings", "A widget shows the days left without opening the app."],
      ]
).map(([title, body, screen, note], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  note,
  visual: { lang, screen },
}));

const heroEyebrow: Partial<Record<Page, string>> = {
  features: "FEATURES",
  "how-to": "HOW TO USE",
  pricing: "PRICING",
  faq: "FAQ",
  news: "NEWS",
  updates: "UPDATES",
  screenshots: "SCREENSHOTS",
};

const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const envLine = ja ? "iPhone・iOS 26以降に対応" : "Requires an iPhone running iOS 26 or later.";
const envNote = ja
  ? "現在のバージョンはiPhone向けです。iPadに最適化されたレイアウトは今後対応予定です。"
  : "The current version is designed for iPhone. An iPad-optimized layout is planned for a future update.";

const newsPosts = getNewsPosts(lang);
---

<AppShell lang={lang} title={title} page={page} description={description}>
  <section class:list={["subpage", `subpage-${page}`]}>
    {heroEyebrow[page] ? (
      <header class="page-hero">
        <div class="page-hero-copy">
          <p class="eyebrow">{heroEyebrow[page]}</p>
          <h1>{title}</h1>
          {subtitle && <p class="lead">{subtitle}</p>}
        </div>
        <figure class="hero-art" aria-hidden="true">
          <span class="blob blob-a"></span>
          <span class="blob blob-b"></span>
          {page === "features" && <AppScreen screen="home" size="sm" lang={lang} class="hero-art-screen" />}
          {page === "how-to" && <AppScreen screen="wishes" size="sm" lang={lang} class="hero-art-screen" />}
          {(page === "news" || page === "updates") && <span class="release-marks"><i></i><i></i><i></i></span>}
          {page === "screenshots" && <AppScreen screen="album" size="sm" lang={lang} class="hero-art-screen" />}
          {page === "faq" && <span class="hero-marks"><b>?</b><i>?</i></span>}
          {page === "pricing" && <img src="/assets/sky-vase.png" alt="" width="1122" height="1402" loading="lazy" decoding="async" />}
        </figure>
      </header>
    ) : (
      <header class="page-intro">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
        {(page === "privacy" || page === "terms") && <small>{legalDate}</small>}
      </header>
    )}

    {page === "features" && (
      <>
        <AppStory class="app-story--page" steps={featureBeats} visual={StoryVisual} />
        <section class="feature-rest">
          <h2 class="block-title">{ja ? "そのほかにできること" : "Everything else it does"}</h2>
          <div class="feature-page-grid">
            {features.map(([icon, heading, body]) => (
              <article data-reveal>
                <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
                <div><h2>{heading}</h2><p>{body}</p></div>
              </article>
            ))}
          </div>
        </section>
        <p class="env-note feature-env"><strong>{envLine}</strong><br />{envNote}</p>
        <div class="page-actions">
          <a class="orange-cta" href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方を見る" : "See how it works"} →</a>
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </>
    )}

    {page === "how-to" && (
      <>
        <AppSimpleSteps steps={howBeats} visual={StoryVisual} />
        <aside class="how-note" data-reveal>
          <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
          <div>
            <h2>{ja ? "はじめての方へ" : "New to Remeet?"}</h2>
            <p>{ja ? "独自アカウントは必要ありません。個人利用のデータは端末内に保存され、共有した再会だけがAppleのiCloudを通じて招待した相手と同期されます。" : "No proprietary account is needed. Personal data stays on your device; only a shared reunion syncs with the invited partner through Apple iCloud."}</p>
          </div>
        </aside>
        <section class="guide-block">
          <h2 class="block-title">{ja ? "もっと詳しく" : "In more detail"}</h2>
          <div class="guide-visual-list">
            {guides.map((guide) => (
              <article class="guide-visual" data-reveal>
                <div class="guide-visual-copy">
                  <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[guide.icon]} /></span>
                  <h3>{guide.title}</h3>
                  <ol>{guide.steps.map((item) => <li>{item}</li>)}</ol>
                  {guide.note && <p class="guide-note">{guide.note}</p>}
                </div>
                <div class="guide-visual-media">
                  {guide.screen ? (
                    <AppScreen screen={guide.screen} size="sm" lang={lang} />
                  ) : (
                    <img src={guide.image} alt={guide.imageAlt} width="1448" height="1086" loading="lazy" decoding="async" />
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
        <aside class="how-help" data-reveal>
          <p>{ja ? "使い方でわからないことがあれば、よくある質問もご覧ください。" : "If anything is still unclear, the FAQ may help."}</p>
          <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問へ" : "Go to the FAQ"} →</a>
        </aside>
        <div class="page-actions">
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </>
    )}

    {page === "screenshots" && (
      <>
        <div class="shot-gallery">
          {screenshots.map(([screen, label]) => (
            <AppScreen screen={screen} size="md" lang={lang} label={label} />
          ))}
        </div>
        <section class="widget-gallery-card">
          <div>
            <p class="eyebrow">WIDGETS</p>
            <h2>{ja ? "再会までを、いつもの画面に。" : "Keep the reunion on the screen you already see."}</h2>
            <p>{ja
              ? "ホーム画面のSmall / Medium / Largeと、ロック画面のインライン・円形・長方形に対応しています。サイズに応じて日数、進捗、ルート、最近の記録などを表示します。"
              : "Use Small, Medium, or Large on the Home Screen, plus inline, circular, and rectangular Lock Screen widgets. Each size shows the countdown, progress, route, or recent records differently."}</p>
          </div>
          <img src="/assets/widget-showcase.png" alt={ja ? "Remeetのホーム画面とロック画面ウィジェット" : "Remeet Home Screen and Lock Screen widgets"} width="1122" height="1402" loading="lazy" decoding="async" />
        </section>
      </>
    )}

    {page === "pricing" && (
      <div class="pricing-story">
        <p class="pricing-summary" data-reveal>{ja
          ? "アプリのダウンロードと個人利用は無料です。共有は1つ目の再会まで無料で、2つ目以降の共有には有料のShare Pass（1枚 ¥500・税込・買い切りの消費型アプリ内課金）が必要です。"
          : "Downloading Remeet and using it on your own is free. Sharing is free for your first reunion; sharing a second or later reunion requires a paid Share Pass (¥500 each, tax included, a one-time consumable in-app purchase)."}</p>

        <div class="plan-pair">
          <section class="plan-card" data-reveal>
            <p class="plan-label">{ja ? "個人利用" : "On your own"}</p>
            <p class="plan-amount"><strong>¥0</strong><span>{ja ? "アプリ内課金なしで使えます" : "no purchase needed"}</span></p>
            <p class="plan-summary">{ja
              ? "予定や思い出を自分の端末で残す基本機能。一部画面に広告が表示されます。"
              : "Every core feature for keeping plans and memories on your own device. Ads appear on some screens."}</p>
            <ul class="plan-list">{planIncludes.map((item) => <li>{item}</li>)}</ul>
          </section>

          <section class="plan-card plan-card--paid" data-reveal style="--reveal-i:1">
            <p class="plan-badge">{ja ? "有料" : "Paid"}</p>
            <p class="plan-label">{ja ? "2つ目以降の再会を共有する" : "Share a second reunion"}</p>
            <p class="plan-amount"><strong>¥500</strong><span>{ja ? "／ 1枚・税込・買い切り" : "per pass, tax included, one time"}</span></p>
            <p class="plan-summary">{ja
              ? "Share Pass 1枚で、1つの再会を1人のパートナーと共有できます。予定・記録・やりたいことをふたりで残せて、その再会は双方に広告が表示されません。"
              : "One Share Pass shares one reunion with one partner. Keep the plan, memories, and wish list together, and that reunion is ad-free for both of you."}</p>
            <ul class="plan-list">
              <li>{ja ? "1枚につき、共有できる再会は1つ" : "One pass covers one reunion"}</li>
              <li>{ja ? "有効期限なし・必要な再会にだけ使用" : "No expiry; use it only when you need it"}</li>
              <li>{ja ? "消費型のため、使用後は復元できません" : "Consumable — it cannot be restored once used"}</li>
              <li>{ja ? "相手が参加するまでPassは消費されません" : "The pass is not spent until your partner joins"}</li>
              <li>{ja ? "サブスクリプションではありません" : "Not a subscription"}</li>
            </ul>
          </section>
        </div>

        <table class="plan-table" data-reveal>
          <caption>{ja ? "無料でできることと、有料が必要になる場面" : "What is free, and where a purchase is needed"}</caption>
          <thead>
            <tr>
              <th scope="col">{ja ? "できること" : "What you do"}</th>
              <th scope="col">{ja ? "料金" : "Cost"}</th>
            </tr>
          </thead>
          <tbody>
            {(ja
              ? [
                  ["アプリのダウンロードと個人利用", "無料"],
                  ["1つ目の再会をパートナーと共有する", "無料"],
                  ["2つ目以降の再会を共有する", "Share Pass 1枚 ¥500"],
                  ["共有した再会を広告なしで使う", "Share Passに含まれます"],
                  ["個人利用中の広告を消す", "現在ご用意がありません"],
                ]
              : [
                  ["Download and personal use", "Free"],
                  ["Share your first reunion", "Free"],
                  ["Share a second or later reunion", "¥500 per Share Pass"],
                  ["Ad-free inside a shared reunion", "Included with the pass"],
                  ["Remove ads during personal use", "Not offered today"],
                ]
            ).map(([what, cost]) => (
              <tr>
                <th scope="row">{what}</th>
                <td>{cost}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="plan-ad-note" data-reveal>{ja
          ? "個人利用では一部画面に広告が表示されます。Share Passを適用して共有した再会は、参加者双方が広告なしで利用できます。価格と提供内容は、App Storeの商品ページおよびアプリ内の購入画面に表示される税込価格が正しいものとします。返金はAppleの規定に従います。"
          : "Personal use includes ads on some screens. A reunion shared with a Share Pass is ad-free for both participants. The tax-inclusive price shown on the App Store product page and the in-app purchase screen is authoritative, and refunds follow Apple’s terms."}</p>
        <p class="env-note"><strong>{envLine}</strong><br />{envNote}</p>
        <div class="page-actions">
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </div>
    )}

    {page === "faq" && (
      <>
        <nav class="faq-tabs" aria-label={ja ? "カテゴリで絞り込み" : "Filter by category"} data-faq-tabs>
          {faqCategories.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-layout">
          <div class="faq-list" data-faq-list>
            {faqs.map(([cat, q, a], i) => (
              <details data-cat={cat} open={i === 0}>
                <summary><span class="q">Q.</span>{q}<span class="mark" aria-hidden="true"></span></summary>
                <p set:html={a.replaceAll("\n\n", "<br /><br />")} />
              </details>
            ))}
            <p class="faq-empty" hidden data-faq-empty>{ja ? "このカテゴリの質問はまだありません。" : "No questions in this category yet."}</p>
          </div>
          <aside class="faq-side">
            <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} /></span>
            <h2>{ja ? "解決しない場合は" : "Still stuck?"}</h2>
            <p>{ja ? "お困りのことがあれば、お気軽にご連絡ください。通常3営業日以内にご返信いたします。" : "If something is still unclear, just get in touch. We usually reply within three business days."}</p>
            <a href={supportHref(lang)} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact us"} →</a>
          </aside>
        </div>
      </>
    )}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legalSections.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {page === "news" && <NewsFeed lang={lang} posts={newsPosts} basePath={ja ? "/ja/news" : "/news"} />}
    {page === "updates" && <AppUpdatesPage lang={lang} appName="Remeet" newsHref={ja ? "/ja/news" : "/news"} />}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      const empty = list.querySelector("[data-faq-empty]");

      tabs.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-cat]");
        if (!btn) return;
        const cat = btn.getAttribute("data-cat");
        let shown = 0;
        items.forEach((item) => {
          const match = cat === "all" || item.getAttribute("data-cat") === cat;
          item.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
        });
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
