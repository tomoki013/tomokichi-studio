---
import AppSimpleSteps from "@tomokichi/app-site/AppSimpleSteps.astro";
import AppStory, { type StoryStep } from "@tomokichi/app-site/AppStory.astro";
import AppUpdatesPage from "@tomokichi/app-site/AppUpdatesPage.astro";
import NewsFeed from "@tomokichi/app-site/NewsFeed.astro";
import { jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import {
  faqs as faqList,
  features as featureList,
  guides as guideList,
  icons,
  type Locale,
  type Page,
  pageDescriptions,
  pick,
  privacySections,
  subtitleMap,
  termsSections,
  titleMap,
} from "../lib/content";
import { supportHref } from "../lib/links";
import { getNewsPosts } from "../lib/news";
import AppScreen from "./AppScreen.astro";
import AppShell from "./AppShell.astro";
import StoryVisual from "./StoryVisual.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const title = pick(ja, titleMap[page]);
const subtitlePair = subtitleMap[page];
const descriptionPair = pageDescriptions[page];
const subtitle = subtitlePair ? pick(ja, subtitlePair) : undefined;
const description = descriptionPair ? pick(ja, descriptionPair) : undefined;
const features = featureList(ja);
const guides = guideList(ja);
const faqs = faqList(ja);
const legalSections = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];
const legalDate = ja
  ? "制定日：2026年7月24日／最終更新日：2026年8月29日"
  : "Effective date: July 24, 2026 / Last updated: August 29, 2026";

const faqCategories = ja
  ? [["all", "すべて"], ["start", "はじめての方へ"], ["feature", "機能について"], ["data", "データについて"], ["other", "その他"]]
  : [["all", "All"], ["start", "Getting started"], ["feature", "Features"], ["data", "Your data"], ["other", "Other"]];

/*
 * Share Pass. Every claim below is checked against the app: the three promises
 * are `SharePassPromiseList`, the pass mechanics are `docs/share-pass.md`, and
 * the refund position is `legal.refunds.body`. Nothing planned or under
 * consideration is stated here as fact.
 */
const freeBasics = ja
  ? [
      ["再会までのカウントダウン", "予定の数に制限はありません"],
      ["待っている間の記録", "写真とメモを、日付ごとに"],
      ["会ったらやりたいこと", "ふたりで叶えたいことのリスト"],
      ["再会のアルバム", "会えた日の写真と振り返り"],
      ["ウィジェット", "ホーム画面とロック画面に"],
      ["最初の再会の共有", "1人のパートナーと、無料で"],
    ]
  : [
      ["Countdown to the reunion", "As many plans as you like"],
      ["Memories while apart", "Photos and notes, by date"],
      ["Things to do together", "The list you will get to"],
      ["Reunion albums", "A photo and reflection from the day"],
      ["Widgets", "On the Home Screen and Lock Screen"],
      ["Your first shared reunion", "With one partner, free"],
    ];

const passPromises = ja
  ? [
      ["ふたりで同じ日を数える", "同じカウントダウンを、ふたりの端末で。相手の街の時間と天気も、ホームに並びます。", "countdown"],
      ["記録とリストを一緒に残す", "待っている間の記録と、会ったらやりたいことリストを、ふたりで書き足せます。相手の記録には、ひとつのリアクションで応えられます。", "camera"],
      ["ふたりとも広告なしで待てる", "Share Passを使った再会では、参加しているふたりのどちらにも広告が表示されません。", "shield"],
    ]
  : [
      ["Count the same days together", "One countdown on both phones, with your partner’s local time and weather beside your own.", "countdown"],
      ["Keep records and lists together", "Both of you can add to the waiting memories and the things-to-do list, and answer each other’s entries with a single reaction.", "camera"],
      ["Wait without ads, both of you", "A reunion shared with a Share Pass shows no ads to either participant.", "shield"],
    ];

const passFacts = ja
  ? [
      ["¥500", "1枚・税込", "買い切りです。サブスクリプションではなく、自動更新もありません。"],
      ["1枚 = 1つの再会", "1人のパートナーと", "1枚のShare Passで、ひとつの再会をひとりのパートナーと共有できます。"],
      ["期限なし", "使うのは相手が参加したとき", "有効期限はありません。招待を送っても、相手が参加するまでPassは使われません。"],
    ]
  : [
      ["¥500", "per pass, tax included", "A one-time purchase. Not a subscription, and nothing renews."],
      ["1 pass = 1 reunion", "with one partner", "One Share Pass shares one reunion with one partner."],
      ["Never expires", "spent only when your partner joins", "A pass has no expiry, and sending an invitation does not spend it — only your partner joining does."],
    ];

const passFaqs: [string, string][] = ja
  ? [
      [
        "Remeetは無料ですか？",
        "はい。再会予定の作成、待っている間の記録、やりたいことリスト、アルバム、ウィジェットなど、Remeetの基本機能はすべて無料で使えます。最初の再会は、1人のパートナーと無料で共有できます。無料で使っている間は、一部の画面に広告が表示されます。",
      ],
      [
        "Share Passとは何ですか？",
        "2回目以降の再会を、パートナーとふたりで待つための買い切りのアイテムです。1枚で1つの再会を1人のパートナーと共有でき、予定・記録・やりたいことがiCloud経由で同期されます。Share Passを使った再会では、ふたりとも広告が表示されません。",
      ],
      [
        "Share Passは二人とも購入する必要がありますか？",
        "いいえ。招待する側が1枚用意すれば、招待された側の購入は必要ありません。招待を受け取った相手は、Remeetをインストールして招待を承認するだけで参加できます。",
      ],
      [
        "Share Passは買い切りですか？",
        "はい。1枚¥500（税込）の買い切りで、サブスクリプションではありません。有効期限もなく、必要な再会のときにだけ使えます。価格は、App Storeとアプリ内の購入画面に表示される税込価格が正となります。",
      ],
      [
        "機種変更した場合はどうなりますか？",
        "購入したShare Passの記録は、同じApple AccountのiCloudに保存されます。新しいiPhoneでも同じApple Accountでサインインし、iCloudを有効にしていれば、未使用のPassはそのまま引き継がれます。共有中の再会も、ふたりがiCloudを使えていれば引き続き同期されます。",
      ],
      [
        "購入を復元できますか？",
        "Share Passは消費型のアプリ内課金のため、Appleの「購入の復元」の対象ではありません。購入したPassが表示されないときは、アプリの設定 → Share Passにある「購入情報を同期」をお試しください。App Storeとの購入情報と、iCloud上の記録を読み直します。解決しない場合は、お問い合わせからご連絡ください。",
      ],
      [
        "返金はできますか？",
        "Share Passは購入と同時にお渡しするため、Remeet側の不具合を除き、運営者からの返金は行っていません。返金の申請はAppleの「問題を報告」から行え、可否はAppleの規定と適用される法律に従います。法律で認められる消費者の権利は制限されません。",
      ],
    ]
  : [
      [
        "Is Remeet free?",
        "Yes. Creating reunions, keeping memories while apart, the things-to-do list, albums, widgets — all of Remeet’s core features are free. Your first reunion can be shared with one partner for free, too. While you use it for free, ads appear on some screens.",
      ],
      [
        "What is Share Pass?",
        "A one-time item for waiting together on a second or later reunion. One pass shares one reunion with one partner, syncing the plan, memories, and wish list through iCloud. A reunion shared with a Share Pass shows no ads to either of you.",
      ],
      [
        "Do both of us need to buy one?",
        "No. Only the person sending the invitation needs a pass. The partner simply installs Remeet and accepts the invitation.",
      ],
      [
        "Is it a one-time purchase?",
        "Yes. ¥500 per pass, tax included, bought once — not a subscription. A pass never expires, so you can keep it until a reunion you want to share. The tax-inclusive price shown on the App Store and on the in-app purchase screen is authoritative.",
      ],
      [
        "What happens when I change phones?",
        "Your Share Pass record is stored in iCloud under your Apple Account. Sign in with the same Apple Account on the new iPhone with iCloud enabled, and any unused passes carry over. A shared reunion keeps syncing as long as both of you can use iCloud.",
      ],
      [
        "Can I restore a purchase?",
        "Share Pass is a consumable in-app purchase, so Apple’s Restore Purchases does not apply to it. If a pass you bought is missing, open Settings → Share Pass in the app and tap “Sync purchases”, which re-reads your App Store purchases and your iCloud record. If that does not resolve it, contact us.",
      ],
      [
        "Can I get a refund?",
        "A pass is delivered the moment you buy it, so the operator does not issue refunds except for faults of Remeet’s own. You can request a refund through Apple’s Report a Problem; Apple decides according to its terms and applicable law. Statutory consumer rights are not restricted.",
      ],
    ];

const sharePassJsonLd =
  page === "share-pass"
    ? serializeJsonLd({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: passFaqs.map(([question, answer]) => ({
          "@type": "Question",
          name: question,
          acceptedAnswer: { "@type": "Answer", text: answer },
        })),
      })
    : "";

/* The screenshots page tells the same story as the app: count the days, keep
   the waiting, plan the day, meet, remember — then the widgets that keep it
   on the screens you already look at. */
const screenshots = (
  ja
    ? [
        ["home", "ホーム", "再会までを数える"],
        ["memories", "待っている間の記録", "離れている日々を残す"],
        ["wishes", "会ったらやりたいこと", "ふたりの予定を並べる"],
        ["reunion", "再会の日", "会えた日を記録する"],
        ["album", "アルバム", "思い出を見返す"],
        ["settings", "設定", "通知やShare Passはここから"],
        ["widgets", "ホーム画面ウィジェット", "アプリを開かずに日数を"],
        ["lockscreen", "ロック画面ウィジェット", "ロック画面にも"],
      ]
    : [
        ["home", "Home", "Count the days"],
        ["memories", "Waiting memories", "Keep the days apart"],
        ["wishes", "Things to do", "Plan the day together"],
        ["reunion", "The reunion", "Record the day you meet"],
        ["album", "Album", "Look back on it"],
        ["settings", "Settings", "Notifications and Share Pass"],
        ["widgets", "Home Screen widgets", "The days, without opening the app"],
        ["lockscreen", "Lock Screen widgets", "On the Lock Screen too"],
      ]
) as [
  "home" | "memories" | "wishes" | "reunion" | "album" | "settings" | "widgets" | "lockscreen",
  string,
  string,
][];

/*
 * Features and How-to lead with the shared scroll story. Only the beats that a
 * real screen can carry become story steps; the rest of the feature list stays
 * a compact grid underneath, so the page does not become thirty screens tall.
 */
const featureBeats: StoryStep[] = (
  ja
    ? [
        ["再会までのカウントダウン", "再会の日までを、日数と進捗で見守ります。少しずつ近づいていく感覚が、待つ時間を支えます。", "home"],
        ["二つの場所をつなぐルート", "ふたりの場所をつなぐルートイラストで、離れている距離をやさしく表現します。正確な地図やリアルタイムの航路ではありません。", "home"],
        ["待っている間の記録", "写真とメモで、離れている日々を自分の記録として残せます。1件につき写真は1枚です。", "memories"],
        ["会ったらやりたいことリスト", "一緒にしたいことをリストに残せます。共有した再会では、招待したパートナーと一緒に編集できます。", "wishes"],
        ["再会の日を、アルバムに", "会えた日の写真と振り返りを残し、完了した再会はアルバムとして見返せます。", "album"],
        ["通知も言語も、設定で選ぶ", "1週間前・前日・当日の朝・再会時刻の通知を個別に切り替えられます。節目や記念日、共有相手からのリアクションも届くことがあります。日本語を含む6言語に対応しています。", "settings"],
      ]
    : [
        ["A countdown to the reunion", "Watch the days and progress until you meet again. Feeling it draw closer carries the waiting.", "home"],
        ["A route between two places", "A gentle route illustration connects both places and softens the distance. It is not a live map or real-time flight path.", "home"],
        ["Memories while apart", "Keep photos and notes from the days in between as your own record. One photo per entry.", "memories"],
        ["Things to do together", "List what you want to do when you meet. On a shared reunion, the invited partner can edit it with you.", "wishes"],
        ["The day itself, in an album", "Save a photo and reflection from the day you meet, then revisit completed reunions in albums.", "album"],
        ["Notifications and language, your way", "Toggle one week before, the day before, the morning of, and reunion time independently. Milestones, anniversaries, and partner reactions may also arrive. Available in six languages.", "settings"],
      ]
).map(([title, body, screen], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  visual: { lang, screen },
}));

const howBeats: StoryStep[] = (
  ja
    ? [
        ["再会予定を作る", "再会の日付と、ふたりがいる場所を設定します。旅行や帰省など、複数の予定を並行して持てます。", "home", "独自アカウントは不要です。作成した予定はすぐにホームに表示されます。"],
        ["待っている日々を記録する", "写真とメモで、離れている時間を残します。毎日でなくてかまいません。", "memories", "記録は端末内に保存され、iCloudにサインインしていれば同じApple Accountの端末へ同期されることがあります。"],
        ["会ったらやりたいことを残す", "再会の日にしたいことを、ひとつずつリストに。共有した再会なら、相手と一緒に書き足せます。", "wishes", "共有した再会だけがAppleのiCloudを通じて同期されます。"],
        ["再会の日を、アルバムに残す", "会えた日の写真と振り返りをアルバムへ。予定が変わったときは日時を変更できます。", "album", "同じ相手の再会は、あとからまとめられます。"],
        ["通知とウィジェットを整える", "設定から通知の種類を選び、ホーム画面やロック画面にウィジェットを置きます。", "settings", "ウィジェットはアプリを開かずに残り日数を確認できます。"],
      ]
    : [
        ["Create a reunion", "Set the date and where each of you will be. Trips and visits can run side by side.", "home", "No proprietary account is needed. A new plan appears on Home right away."],
        ["Record the waiting days", "Keep photos and notes from the time apart. It does not have to be every day.", "memories", "Records stay on your device, and may sync to other devices on the same Apple Account if you use iCloud."],
        ["Save things to do together", "List what you want to do when you meet. On a shared reunion you can add to it together.", "wishes", "Only a shared reunion syncs, through Apple iCloud."],
        ["Keep the day in an album", "Save a photo and reflection from the day you meet, or change the date if plans move.", "album", "Reunions with the same person can be grouped later."],
        ["Set up notices and widgets", "Choose which notifications you want in Settings, then place a widget on your Home or Lock Screen.", "settings", "A widget shows the days left without opening the app."],
      ]
).map(([title, body, screen, note], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  note,
  visual: { lang, screen },
}));

const heroEyebrow: Partial<Record<Page, string>> = {
  features: "FEATURES",
  "how-to": "HOW TO USE",
  "share-pass": "SHARE PASS",
  faq: "FAQ",
  news: "NEWS",
  updates: "UPDATES",
  screenshots: "SCREENSHOTS",
};

const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const envLine = ja ? "iPhone・iOS 26以降に対応" : "Requires an iPhone running iOS 26 or later.";
const envNote = ja
  ? "現在のバージョンはiPhone向けです。iPadに最適化されたレイアウトは今後対応予定です。"
  : "The current version is designed for iPhone. An iPad-optimized layout is planned for a future update.";

const newsPosts = getNewsPosts(lang);
---

<AppShell lang={lang} title={title} page={page} description={description} jsonLd={sharePassJsonLd}>
  <section class:list={["subpage", `subpage-${page}`]}>
    {heroEyebrow[page] ? (
      <header class="page-hero">
        <div class="page-hero-copy">
          <p class="eyebrow">{heroEyebrow[page]}</p>
          <h1>{title}</h1>
          {subtitle && <p class="lead">{subtitle}</p>}
        </div>
        <figure class="hero-art" aria-hidden="true">
          <span class="blob blob-a"></span>
          <span class="blob blob-b"></span>
          {page === "features" && <AppScreen screen="home" size="sm" lang={lang} class="hero-art-screen" />}
          {page === "how-to" && <AppScreen screen="wishes" size="sm" lang={lang} class="hero-art-screen" />}
          {(page === "news" || page === "updates") && <span class="release-marks"><i></i><i></i><i></i></span>}
          {page === "screenshots" && <AppScreen screen="album" size="sm" lang={lang} class="hero-art-screen" />}
          {page === "faq" && <span class="hero-marks"><b>?</b><i>?</i></span>}
          {page === "share-pass" && <AppScreen screen="home" size="sm" lang={lang} class="hero-art-screen" />}
        </figure>
      </header>
    ) : (
      <header class="page-intro">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
        {(page === "privacy" || page === "terms") && <small>{legalDate}</small>}
      </header>
    )}

    {page === "features" && (
      <>
        <AppStory class="app-story--page" steps={featureBeats} visual={StoryVisual} />
        <section class="feature-rest">
          <h2 class="block-title">{ja ? "そのほかにできること" : "Everything else it does"}</h2>
          <div class="feature-page-grid">
            {features.map(([icon, heading, body]) => (
              <article data-reveal>
                <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
                <div><h2>{heading}</h2><p>{body}</p></div>
              </article>
            ))}
          </div>
        </section>
        <p class="env-note feature-env"><strong>{envLine}</strong><br />{envNote}</p>
        <div class="page-actions">
          <a class="orange-cta" href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方を見る" : "See how it works"} →</a>
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </>
    )}

    {page === "how-to" && (
      <>
        <AppSimpleSteps steps={howBeats} visual={StoryVisual} />
        <aside class="how-note" data-reveal>
          <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
          <div>
            <h2>{ja ? "はじめての方へ" : "New to Remeet?"}</h2>
            <p>{ja ? "独自アカウントは必要ありません。個人利用のデータは端末内に保存され、共有した再会だけがAppleのiCloudを通じて招待した相手と同期されます。" : "No proprietary account is needed. Personal data stays on your device; only a shared reunion syncs with the invited partner through Apple iCloud."}</p>
          </div>
        </aside>
        <section class="guide-block">
          <h2 class="block-title">{ja ? "もっと詳しく" : "In more detail"}</h2>
          <div class="guide-visual-list">
            {guides.map((guide) => (
              <article class="guide-visual" data-reveal>
                <div class="guide-visual-copy">
                  <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[guide.icon]} /></span>
                  <h3>{guide.title}</h3>
                  <ol>{guide.steps.map((item) => <li>{item}</li>)}</ol>
                  {guide.note && <p class="guide-note">{guide.note}</p>}
                </div>
                <div class="guide-visual-media">
                  <AppScreen screen={guide.screen} size="sm" lang={lang} tone={guide.screen === "lockscreen" ? "graphite" : "titanium"} />
                </div>
              </article>
            ))}
          </div>
        </section>
        <aside class="how-help" data-reveal>
          <p>{ja ? "使い方でわからないことがあれば、よくある質問もご覧ください。" : "If anything is still unclear, the FAQ may help."}</p>
          <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問へ" : "Go to the FAQ"} →</a>
        </aside>
        <div class="page-actions">
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </>
    )}

    {page === "screenshots" && (
      <>
        <ol class="shot-gallery">
          {screenshots.map(([screen, label, caption], i) => (
            <li>
              <AppScreen screen={screen} size="md" lang={lang} label={`${String(i + 1).padStart(2, "0")}　${label}`} tone={screen === "lockscreen" ? "graphite" : "titanium"} />
              <p>{caption}</p>
            </li>
          ))}
        </ol>
        <section class="widget-gallery-card">
          <div>
            <p class="eyebrow">WIDGETS</p>
            <h2>{ja ? "再会までを、いつもの画面に。" : "Keep the reunion on the screen you already see."}</h2>
            <p>{ja
              ? "ホーム画面のSmall / Medium / Largeと、ロック画面のインライン・円形・長方形に対応しています。サイズに応じて日数、進捗、ルート、最近の記録などを表示します。"
              : "Use Small, Medium, or Large on the Home Screen, plus inline, circular, and rectangular Lock Screen widgets. Each size shows the countdown, progress, route, or recent records differently."}</p>
          </div>
          <div class="widget-gallery-screens">
            <AppScreen screen="widgets" size="sm" lang={lang} />
            <AppScreen screen="lockscreen" size="sm" lang={lang} tone="graphite" />
          </div>
        </section>
      </>
    )}

    {page === "share-pass" && (
      <div class="share-pass">
        <section class="pass-free" data-reveal>
          <div class="pass-free-copy">
            <p class="eyebrow">{ja ? "まず、無料で" : "FREE TO BEGIN WITH"}</p>
            <h2>{ja ? "Remeetの基本機能は、すべて無料です。" : "Everything Remeet does on its own is free."}</h2>
            <p>{ja
              ? "アプリのダウンロードも、再会を数えることも、思い出を残すことも、無料のまま使い続けられます。最初の再会は、1人のパートナーと無料で共有できます。無料で使っている間は、一部の画面に広告が表示されます。"
              : "Downloading the app, counting down to a reunion, keeping memories — all of it stays free for as long as you like. Your first reunion can be shared with one partner for free. While you use it for free, ads appear on some screens."}</p>
          </div>
          <ul class="pass-free-list">
            {freeBasics.map(([heading, note]) => (
              <li><strong>{heading}</strong><span>{note}</span></li>
            ))}
          </ul>
        </section>

        <section class="pass-concept" data-reveal>
          <div class="pass-ticket" aria-hidden="true">
            <span class="pass-ticket-label">SHARE PASS</span>
            <strong>{ja ? "ふたりで、待つ。" : "Wait together."}</strong>
            <small>{ja ? "1枚で、ひとつの再会を" : "One pass, one reunion"}</small>
          </div>
          <div class="pass-concept-copy">
            <p class="eyebrow">{ja ? "SHARE PASSとは" : "WHAT SHARE PASS IS"}</p>
            <h2>{ja ? "ひとつの再会を、ふたりで待つためのチケット。" : "A ticket for waiting on one reunion, together."}</h2>
            <p>{ja
              ? "Remeetの再会は、ひとりで待つこともできます。でも、待っているのは向こう側にも、もうひとりいる。Share Passは、2回目以降の再会をその相手と共有するための、買い切りのチケットです。同じ日を数え、記録とリストを一緒に残し、その再会だけは広告のない場所になります。"
              : "A reunion in Remeet can be waited for alone. But there is someone waiting on the other side, too. Share Pass is a one-time ticket that shares a second or later reunion with that person: you count the same days, keep records and lists together, and that reunion becomes a place without ads."}</p>
            <p class="pass-concept-note">{ja
              ? "招待する側が1枚用意すれば、相手の購入は必要ありません。"
              : "Only the person sending the invitation needs a pass."}</p>
          </div>
        </section>

        <section class="pass-promises">
          <h2 class="block-title">{ja ? "Share Passでできること" : "What a Share Pass does"}</h2>
          <div class="pass-promise-grid">
            {passPromises.map(([heading, body, icon], i) => (
              <article data-reveal style={`--reveal-i:${i}`}>
                <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
                <h3>{heading}</h3>
                <p>{body}</p>
              </article>
            ))}
          </div>
          <div class="pass-visual" data-reveal>
            <AppScreen screen="home" size="md" lang={lang} label={ja ? "共有中の再会のホーム" : "Home on a shared reunion"} />
            <AppScreen screen="wishes" size="md" lang={lang} label={ja ? "ふたりで書き足すリスト" : "A list you both add to"} />
          </div>
        </section>

        <section class="pass-facts" data-reveal>
          {passFacts.map(([figure, unit, note]) => (
            <div class="pass-fact">
              <p class="pass-fact-figure"><strong>{figure}</strong><span>{unit}</span></p>
              <p>{note}</p>
            </div>
          ))}
        </section>
        <p class="pass-fine-print" data-reveal>{ja
          ? "Share Passは消費型のアプリ内課金です。価格と提供内容は、App Storeの商品ページおよびアプリ内の購入画面に表示される税込価格が正しいものとします。返金はAppleの規定に従います。"
          : "Share Pass is a consumable in-app purchase. The tax-inclusive price shown on the App Store product page and the in-app purchase screen is authoritative, and refunds follow Apple’s terms."}</p>

        <section class="pass-faq" aria-labelledby="pass-faq-title">
          <h2 class="block-title" id="pass-faq-title">{ja ? "よくある質問" : "Questions people ask"}</h2>
          <div class="faq-list">
            {passFaqs.map(([q, a], i) => (
              <details open={i === 0}>
                <summary><span class="q">Q.</span>{q}<span class="mark" aria-hidden="true"></span></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
          <p class="pass-faq-more"><a href={ja ? "/ja/faq" : "/faq"}>{ja ? "そのほかの質問はこちら" : "More questions answered in the FAQ"} →</a></p>
        </section>

        <p class="env-note"><strong>{envLine}</strong><br />{envNote}</p>
        <div class="page-actions">
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </div>
    )}

    {page === "faq" && (
      <>
        <nav class="faq-tabs" aria-label={ja ? "カテゴリで絞り込み" : "Filter by category"} data-faq-tabs>
          {faqCategories.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-layout">
          <div class="faq-list" data-faq-list>
            {faqs.map(([cat, q, a], i) => (
              <details data-cat={cat} open={i === 0}>
                <summary><span class="q">Q.</span>{q}<span class="mark" aria-hidden="true"></span></summary>
                <p set:html={a.replaceAll("\n\n", "<br /><br />")} />
              </details>
            ))}
            <p class="faq-empty" hidden data-faq-empty>{ja ? "このカテゴリの質問はまだありません。" : "No questions in this category yet."}</p>
          </div>
          <aside class="faq-side">
            <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} /></span>
            <h2>{ja ? "解決しない場合は" : "Still stuck?"}</h2>
            <p>{ja ? "お困りのことがあれば、お気軽にご連絡ください。通常3営業日以内にご返信いたします。" : "If something is still unclear, just get in touch. We usually reply within three business days."}</p>
            <a href={supportHref(lang)} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact us"} →</a>
          </aside>
        </div>
      </>
    )}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legalSections.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {page === "news" && <NewsFeed lang={lang} posts={newsPosts} basePath={ja ? "/ja/news" : "/news"} />}
    {page === "updates" && <AppUpdatesPage lang={lang} appName="Remeet" newsHref={ja ? "/ja/news" : "/news"} />}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      const empty = list.querySelector("[data-faq-empty]");

      tabs.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-cat]");
        if (!btn) return;
        const cat = btn.getAttribute("data-cat");
        let shown = 0;
        items.forEach((item) => {
          const match = cat === "all" || item.getAttribute("data-cat") === cat;
          item.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
        });
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
