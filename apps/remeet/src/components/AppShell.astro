---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";
import { appSiteUrl, mainSiteUrl } from "@tomokichi/app-site/urls";
import { supportHref } from "../lib/links";

type Locale = "ja" | "en";
const { lang, title, page = "", routePath = page, description, jsonLd = "", noindex = false } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  /** Route used for canonical and hreflang, when it differs from `page`. */
  routePath?: string;
  description?: string;
  jsonLd?: string;
  noindex?: boolean;
};
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${routePath}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${routePath}`.replace(/\/$/, "") || "/";
const labels = ja
  ? { features: "機能", how: "使い方", pricing: "料金", faq: "よくある質問", news: "ニュース" }
  : { features: "Features", how: "How it works", pricing: "Pricing", faq: "FAQ", news: "News" };
const nav = [
  { slug: "features", label: labels.features, href: href("features") },
  { slug: "how-to", label: labels.how, href: href("how-to") },
  { slug: "pricing", label: labels.pricing, href: href("pricing") },
];
const footerColumns = ja
  ? [
      { title: "プロダクト", links: [{ label: "機能", href: href("features") }, { label: "使い方", href: href("how-to") }, { label: "スクリーンショット", href: href("screenshots") }, { label: "料金", href: href("pricing") }] },
      { title: "サポート", links: [{ label: "よくある質問", href: href("faq") }, { label: "ニュース", href: href("news") }, { label: "アップデート情報", href: href("updates") }, { label: "お問い合わせ", href: supportHref("ja"), external: true }] },
      { title: "規約", links: [{ label: "プライバシーポリシー", href: href("privacy") }, { label: "利用規約", href: href("terms") }, { label: "特定商取引法に基づく表記", href: href("commercial-transactions") }] },
      { title: "運営者情報", links: [{ label: "運営サイト", href: mainSiteUrl("ja"), external: true }, { label: "ほかのアプリ", href: mainSiteUrl("ja", "/products"), external: true }] },
    ]
  : [
      { title: "Product", links: [{ label: "Features", href: href("features") }, { label: "How it works", href: href("how-to") }, { label: "Screenshots", href: href("screenshots") }, { label: "Pricing", href: href("pricing") }] },
      { title: "Support", links: [{ label: "FAQ", href: href("faq") }, { label: "News", href: href("news") }, { label: "App updates", href: href("updates") }, { label: "Contact", href: supportHref("en"), external: true }] },
      { title: "Legal", links: [{ label: "Privacy Policy", href: href("privacy") }, { label: "Terms of Service", href: href("terms") }, { label: "Commercial Transactions", href: href("commercial-transactions") }] },
      { title: "Operator", links: [{ label: "Operator site", href: mainSiteUrl("en"), external: true }, { label: "Other apps", href: mainSiteUrl("en", "/products"), external: true }] },
    ];
const mobileFooterLinks = ja
  ? [
      { label: "お問い合わせ", href: supportHref("ja"), external: true },
      { label: "プライバシーポリシー", href: href("privacy") },
      { label: "利用規約", href: href("terms") },
      { label: "運営サイト", href: mainSiteUrl("ja"), external: true },
      { label: "ほかのアプリ", href: mainSiteUrl("ja", "/products"), external: true },
    ]
  : [
      { label: "Contact", href: supportHref("en"), external: true },
      { label: "Privacy Policy", href: href("privacy") },
      { label: "Terms of Service", href: href("terms") },
      { label: "Operator site", href: mainSiteUrl("en"), external: true },
      { label: "Other apps", href: mainSiteUrl("en", "/products"), external: true },
    ];
const metaDescription = description ?? (ja
  ? "Remeetは、再会までをカウントダウンし、待っている日々を記録して、1人のパートナーとも共有できるiPhoneアプリです。個人利用と最初の共有は無料。"
  : "Remeet counts down to your next reunion, keeps the waiting days, and can share one reunion with one partner. Personal use and the first shared reunion are free.");
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
---

<AppSiteShell
  lang={lang}
  title={title}
  description={metaDescription}
  page={page}
  brand="Remeet"
  logoImage="/assets/remeet-icon.png"
  favicon="/assets/remeet-favicon.png"
  ogImage="/assets/og.png"
  tagline={ja ? "再会までの時間を、特別な思い出に。" : "Make the wait part of your story."}
  siteUrl={appSiteUrl("remeet")}
  homeHref={ja ? "/ja" : "/"}
  jaPageHref={jaPageHref}
  enPageHref={enPageHref}
  nav={nav}
  footerColumns={footerColumns}
  mobileFooterLinks={mobileFooterLinks}
  appStoreLabel={storeLabel}
  appStoreHref=""
  appStoreComingSoon
  menuLabel={ja ? "メニュー" : "Menu"}
  menuCloseLabel={ja ? "メニューを閉じる" : "Close menu"}
  pageClass="remeet-page"
  themeColor="#f8f4ef"
  jsonLd={jsonLd}
  noindex={noindex}
>
  <slot />
  <script is:inline>
    (() => {
      const initReveal = () => {
        const items = document.querySelectorAll(
          ".landing-sections section, .feature-grid article, .step-grid article, .subpage > :not(.page-intro):not(.page-hero), .app-hero-notice, .shot-gallery .app-phone-frame",
        );
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          items.forEach((item) => {
            item.classList.add("is-visible");
          });
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          // Long guides and legal documents can be taller than the viewport;
          // a 12% threshold would make them mathematically impossible to reveal.
          { threshold: 0.01, rootMargin: "0px 0px -7% 0px" },
        );
        items.forEach((item, index) => {
          if (item.classList.contains("is-visible")) return;
          item.classList.add("reveal-item");
          item.style.setProperty("--reveal-delay", `${(index % 6) * 45}ms`);
          observer.observe(item);
        });
      };
      document.addEventListener("astro:page-load", initReveal);
      initReveal();
    })();
  </script>
</AppSiteShell>
