---
import { Image } from "astro:assets";
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import { appApplicationGraph, jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import { appSiteUrl } from "@tomokichi/app-site/urls";
import onboardingCouple from "../assets/screens/onboarding-couple-clean.png";
import AppScreen from "./AppScreen.astro";
import AppShell from "./AppShell.astro";

type Locale = "ja" | "en";
const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const c = ja
  ? {
      title: "再会までの時間を、特別な思い出に。",
      body: "大切な人と次に会える日までをカウントダウン。\n離れている日々の写真や気持ち、\n会ったらやりたいことを、自分の記録として残せます。",
      store: "App Storeで近日公開",
      notice: "Remeet公式ブランドサイトを公開しました",
      features: "Remeetの特徴",
      featureSub: "距離を、やさしくつなぐ機能たち。",
      howTitle: "使い方はかんたん、4ステップ",
      howLink: "使い方を見る",
      screenTitle: "待つ時間が、ひとつの流れになる。",
      screenBody: "カウントダウンから、思い出、やりたいこと、再会後のアルバムまで。実際のアプリ画面でRemeetの一連の体験をご覧ください。",
      screenLink: "すべてのスクリーンショット",
      widgetTitle: "ウィジェットで、もっと身近に",
      widgetBody: "ホーム画面やロック画面から、再会までの日数をいつでも確認できます。",
      storyTitle: "距離があるから、\nつながりは、もっとやさしくなる。",
      storyBody: "会えない時間は、さみしいだけじゃない。\n思い出を重ねる時間でもある。\nRemeetは、大切な人との再会を待つ日々を\nそっと支える小さなきっかけになりますように。",
      cta: "再会の日を、もっと楽しみに。",
      ctaSub: "Remeetをはじめて、待つ時間も物語の一部に。",
      description: "Remeetは、再会までをカウントダウンし、待っている日々を記録して、1人のパートナーとも共有できるiPhoneアプリです。個人利用と最初の共有は無料。",
      env: "iPhone・iOS 26以降に対応",
      envNote: "現在のバージョンはiPhone向けです。iPadに最適化されたレイアウトは今後対応予定です。",
    }
  : {
      title: "Make the wait part of your story.",
      body: "Count down to the day you meet someone important again.\nKeep photos, thoughts, and things you want to do\nwhile the distance slowly becomes smaller.",
      store: "Coming soon on the App Store",
      notice: "The official Remeet brand site is now live",
      features: "Remeet features",
      featureSub: "Thoughtful ways to stay close across the distance.",
      howTitle: "Simple to use in four steps",
      howLink: "See how it works",
      screenTitle: "The wait becomes one continuous story.",
      screenBody: "From countdown to memories, wish lists, and the album after reunion. See the complete flow through screens captured from the real app.",
      screenLink: "View all screenshots",
      widgetTitle: "Always close with widgets",
      widgetBody: "Check the days remaining at a glance from your Home Screen or Lock Screen.",
      storyTitle: "Distance can make\nyour connection feel even gentler.",
      storyBody: "Time apart isn’t only about missing someone.\nIt can be time to gather memories, too.\nRemeet offers small moments that support\nthe wait until you meet again.",
      cta: "Make the reunion worth the wait.",
      ctaSub: "Start with Remeet and let the waiting days become part of the story.",
      description: "Remeet counts down to your next reunion, keeps the waiting days, and can share one reunion with one partner. Personal use and the first shared reunion are free.",
      env: "Requires an iPhone running iOS 26 or later.",
      envNote: "The current version is designed for iPhone. An iPad-optimized layout is planned for a future update.",
    };

const features = ja
  ? [
      ["再会までをカウントダウン", "次に会える日を設定すると、日数と進捗を自動で表示。楽しみが少しずつ近づきます。"],
      ["ルートでつながるイラスト", "ふたりの場所をつなぐルートイラストで、離れている距離をやさしく表現します。"],
      ["待っている時間を思い出に", "メモや写真を、自分の記録として残せます。小さな日常も大切な記憶になります。"],
      ["ふたりで待つ再会", "最初の再会は無料で共有。予定、記録、やりたいことを、招待した相手と一緒に残せます。"],
      ["ウィジェットでいつでも確認", "ホーム画面やロック画面で、再会までの日数をいつでも確認できます。"],
      ["再会をアルバムに保存", "再会の写真と振り返りをアルバムに。未来の自分への宝物になります。"],
    ]
  : [
      ["Countdown to reunion", "Set your next meeting date and follow the days and progress as the moment draws closer."],
      ["A gentle route illustration", "A gentle route illustration connects both places and gives the distance a softer shape."],
      ["Turn waiting into memories", "Save notes and photos as your own record. Even ordinary days become part of the story."],
      ["Wait together", "Share your first reunion for free, then keep the plan, memories, and wish list with the partner you invite."],
      ["Always close with widgets", "Keep the countdown on the Home Screen and Lock Screen."],
      ["Save reunions in albums", "Keep a reunion photo and reflection in an album you can revisit later."],
    ];
// One real screen per feature; `null` keeps the widget illustration, since a
// Home Screen widget cannot be captured from inside the app.
const featureScreens = ["home", "home", "memories", "wishes", null, "album"] as const;
const steps = ja
  ? [
      ["1", "再会予定を作る", "場所と、次に会える日を設定します。"],
      ["2", "待っている日々を記録する", "写真やメモで、離れている時間を残します。"],
      ["3", "会ったらやりたいことを残す", "再会の日にしたいことを、ひとつずつリストに。"],
      ["4", "再会の日を記録してアルバムに残す", "会えた日の写真と振り返りを、アルバムへ。"],
    ]
  : [
      ["1", "Create a reunion", "Set both places and the next date you will meet."],
      ["2", "Record the waiting days", "Keep photos and notes from the time apart."],
      ["3", "Save things to do", "List what you want to do when you meet again."],
      ["4", "Capture the reunion in an album", "Save a photo and reflection from the day you meet."],
    ];

const jsonLd = serializeJsonLd(
  appApplicationGraph({
    siteUrl: appSiteUrl("remeet"),
    name: "Remeet",
    description: c.description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS 26 or later",
    path: base || "/",
    image: "/assets/og.png",
  }),
);
---

<AppShell lang={lang} title={c.title} description={c.description} jsonLd={jsonLd}>
  <section class="new-home">
    <img class="home-sky" src="/assets/sky-vase.png" alt="" width="1122" height="1402" decoding="async" />
    <div class="home-stack">
      <AppHeroChrome lang={lang} date="2026-08-01" news={c.notice} newsHref={`${base}/news`} />
      <div class="home-copy">
        <p class="hero-concept">DISTANCE · TIME · REUNION</p>
        <h1>{c.title}</h1>
        <p>{c.body.split("\n").map((line) => <>{line}<br /></>)}</p>
        <div class="distance-panel" aria-hidden="true">
          <div class="distance-city">
            <span class="distance-pin"></span>
            <strong>Tokyo</strong>
          </div>
          <div class="distance-mid">
            <span class="distance-days">23</span>
            <span class="distance-unit">{ja ? "日" : "DAYS"}</span>
            <span class="distance-caption">{ja ? "また会えるまで" : "until we meet"}</span>
          </div>
          <div class="distance-city distance-city-end">
            <span class="distance-pin"></span>
            <strong>Paris</strong>
          </div>
          <span class="distance-line"></span>
        </div>
        <div class="home-actions">
          <span class="store-soon" aria-disabled="true">{c.store}</span>
          <a class="secondary-link" href={`${base}/how-to`}>{c.howLink}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="home-phone-picture">
        <AppScreen screen="home" size="lg" lang={lang} priority />
      </div>
    </div>
  </section>

  <div class="landing-sections">
    <section class="features landing-pad" id="features">
      <div class="ornate-title"><span></span><div><h2>{c.features}</h2><p>{c.featureSub}</p></div><span></span></div>
      <div class="feature-grid">
        {features.map(([title, body], i) => (
          <article>
            <div class="feature-copy">
              <small>{String(i + 1).padStart(2, "0")}</small>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
            <figure class:list={["feature-shot", featureScreens[i] === null && "is-wide"]}>
              {featureScreens[i] ? (
                <AppScreen screen={featureScreens[i]} size="sm" lang={lang} />
              ) : (
                <picture>
                  <source srcset="/assets/feature-widget.webp" type="image/webp" />
                  <img
                    src="/assets/feature-widget.png"
                    alt={title}
                    width="1448"
                    height="1086"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              )}
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section class="how landing-pad" id="how">
      <h2>{c.howTitle}</h2>
      <div class="step-grid">
        {steps.map(([n, title, body], i) => (
          <article>
            <div class="step-icon" aria-hidden="true">{["⌖", "✎", "▣", "♡"][i]}</div>
            <div>
              <small>{n}</small>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
            {i < steps.length - 1 && <b aria-hidden="true">›</b>}
          </article>
        ))}
      </div>
    </section>

    <section class="screen-story landing-pad" id="screens">
      <header class="screen-story-copy">
        <p class="chapter-index">REAL APP / FOUR CHAPTERS</p>
        <h2>{c.screenTitle}</h2>
        <p>{c.screenBody}</p>
        <a href={`${base}/screenshots`}>{c.screenLink} →</a>
      </header>
      <div class="screen-story-rail">
        {(["home", "memories", "wishes", "album"] as const).map((screen, i) => (
          <figure>
            <AppScreen screen={screen} size={i === 1 || i === 2 ? "sm" : "md"} lang={lang} />
            <figcaption><span>0{i + 1}</span>{ja ? ["再会まで", "思い出", "やりたいこと", "アルバム"][i] : ["Countdown", "Memories", "Wish list", "Album"][i]}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="widgets landing-pad" id="widgets">
      <div><h2>{c.widgetTitle}</h2><p>{c.widgetBody}</p></div>
      <div class="widget-art">
        <img
          src="/assets/widgets.png"
          alt={ja ? "Remeetのホーム画面とウィジェット" : "Remeet home screen and widgets"}
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="closing-chapter landing-pad" id="story">
      <div class="chapter-art">
        <Image
          src={onboardingCouple}
          alt={ja ? "夕暮れの海を並んで眺めるふたりの後ろ姿" : "Two people seen from behind, sitting together by the sea at sunset"}
          widths={[520, 760, 1040]}
          sizes="(max-width: 760px) calc(100vw - 36px), 46vw"
          quality={88}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="chapter-copy">
        <p class="chapter-index">BETWEEN HERE &amp; THEN</p>
        <h2>{c.storyTitle.split("\n").map((line) => <>{line}<br /></>)}</h2>
        <p>{c.storyBody.split("\n").map((line) => <>{line}<br /></>)}</p>
        <div class="chapter-route" aria-hidden="true"><i></i><span>♡</span><i></i></div>
      </div>
    </section>

    <section class="start-card landing-pad" id="download">
      <div class="start-copy">
        <p class="chapter-index">START YOUR COUNTDOWN</p>
        <h2>{c.cta}</h2>
        <p>{c.ctaSub}</p>
      </div>
      <div class="start-details">
        <div class="start-price">
          <span>{ja ? "個人利用 + 最初の共有" : "PERSONAL + FIRST SHARE"}</span>
          <strong>{ja ? "無料" : "Free"}</strong>
          <small>{ja ? "追加の共有はShare Pass 1枚 ¥500" : "Additional sharing: one ¥500 Share Pass"}</small>
        </div>
        <p class="env-note"><strong>{c.env}</strong><br />{c.envNote}</p>
        <div class="buttons">
          <span class="store store-soon" aria-disabled="true">●　{c.store}</span>
          <a class="secondary" href={`${base}/pricing`}>{ja ? "料金の詳細" : "Pricing details"} →</a>
        </div>
      </div>
    </section>
  </div>
</AppShell>
