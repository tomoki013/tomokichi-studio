---
import AppErrorPage from "@tomokichi/app-site/AppErrorPage.astro";
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<AppShell
  lang="en"
  title="Something went wrong"
  description="This page could not be loaded."
  noindex
>
  <AppErrorPage kind="error"
    links={[
      { label: "FAQ", jaLabel: "よくある質問", href: "/faq", jaHref: "/ja/faq" },
      { label: "How to play", jaLabel: "遊び方", href: "/how-to", jaHref: "/ja/how-to" },
    ]}
  />
</AppShell>
