---
import RegionDetailPage from "../../../components/RegionDetailPage.astro";
import { regionSlug, regions } from "../../../lib/content";
import "../../../styles/global.css";

export function getStaticPaths() {
  return regions.map((region) => ({
    params: { country: regionSlug(region.code) },
    props: { region },
  }));
}

const { region } = Astro.props as { region: (typeof regions)[number] };
---
<RegionDetailPage lang="ja" region={region} />
