---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import PhoneFrame from "@tomokichi/app-site/PhoneFrame.astro";
import { appApplicationGraph, jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import { appSiteUrl } from "@tomokichi/app-site/urls";
import { languagesEn, languagesJa, regions } from "../lib/content";
import AppShell from "./AppShell.astro";

type Locale = "ja" | "en";
const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const storeLabel = ja ? "App Storeでダウンロード" : "Download on the App Store";
const appStoreHref = "https://apps.apple.com/app/id6798378768";
const homeImg = ja ? "/assets/colorvia-home.webp" : "/assets/colorvia-home-en.webp";
const homeImgPng = ja ? "/assets/colorvia-home.png" : "/assets/colorvia-home-en.png";

const description = ja
  ? "Colorviaは、訪れた国・州・都道府県を塗ることに集中した訪問記録アプリです。地図そのものが体験です。App Storeで配信中。"
  : "Colorvia is a visited-places app focused on colouring countries, states and prefectures. The map is the experience. Available now on the App Store.";

const features = ja
  ? [
      ["🔍", "国名で選ぶだけ", "国名を検索するか、地域別の一覧から訪れた国を選ぶだけ。複雑な入力はありません。"],
      ["🗺", "自分だけの世界地図", "訪問国が色づき、ピンチやドラッグで地図を眺められます。"],
      ["▣", "国の中まで記録", "対応11か国では、都道府県や州など国内の訪れた場所まで残せます。"],
      ["◔", "訪問数と割合", "訪問国数、世界の訪問率、大陸別・地域別の統計を確認できます。"],
      ["💾", "JSONで移行", "設定から書き出し・読み込みでき、新しい端末へ手動で移せます。"],
      ["✈", "オフラインでも", "地図・記録・統計・地名検索など主要機能はオフラインで使えます。"],
    ]
  : [
      ["🔍", "Search and select", "Search by country name or browse by region, then select the places you have visited."],
      ["🗺", "Your world map", "Visited countries light up. Pinch, drag and reset the map anytime."],
      ["▣", "Go beyond countries", "In 11 supported countries, record prefectures, states, provinces and travel areas."],
      ["◔", "Counts and progress", "See visit counts, world percentage and breakdowns by continent and region."],
      ["💾", "JSON transfer", "Export and import from Settings to move records to a new device."],
      ["✈", "Works offline", "Map, tracking, stats and place search work without a network."],
    ];

const steps = ja
  ? [
      ["1", "＋から国を追加", "ホーム右下の＋を開き、検索または一覧から訪れた国にチェックを付けて確定します。"],
      ["2", "地図と統計を見る", "世界地図が色づき、訪問国数や割合をシートで確認できます。"],
      ["3", "地域まで残す", "対応国では、地名検索や一覧から都道府県・州などを記録できます。"],
    ]
  : [
      ["1", "Add countries with +", "Open +, search or browse, check countries you visited, then confirm."],
      ["2", "See map and stats", "The world map fills in colour; open the sheet for counts and percentages."],
      ["3", "Record regions", "In supported countries, mark prefectures, states and more via search or lists."],
    ];

const faqs = ja
  ? [
      ["無料で使えますか？", "はい。基本機能は無料です。画面高に余裕がある端末では、ホーム下部にバナー広告が表示される場合があります。買い切りの「広告を削除」で非表示にできます。"],
      ["地図上で国をタップして追加できますか？", "いいえ。世界地図のタップでは国を追加できません。ホームの＋から国選択リストで追加します。地図では拡大・移動・リセットができます。"],
      ["データをバックアップできますか？", "はい。設定の「データ管理」からJSONで書き出し、別の端末で読み込めます。iCloudなどの自動同期はありません。"],
    ]
  : [
      ["Is Colorvia free?", "Yes. Core features are free. On taller devices, a banner ad may appear at the bottom of Home. A one-time Remove Ads purchase hides it."],
      ["Can I tap the world map to add a country?", "No. Use Home’s + button and the country list. The map supports zoom, pan and reset only."],
      ["Can I back up my data?", "Yes. Export JSON from Settings → Data management and import it on another device. There is no automatic iCloud sync."],
    ];

const jsonLd = serializeJsonLd(
  appApplicationGraph({
    siteUrl: appSiteUrl("colorvia"),
    name: "Colorvia",
    description,
    applicationCategory: "TravelApplication",
    operatingSystem: "iOS 18.0 or later",
    path: base || "/",
    image: "/og.png",
    appStoreUrl: "https://apps.apple.com/app/id6798378768",
  }),
);
---

<AppShell
  lang={lang}
  title={ja ? "訪れた場所を塗る。地図が進捗になる。" : "Colour the places you’ve been. Progress on a map."}
  description={description}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-orb hero-orb-a"></span>
      <span class="hero-orb hero-orb-b"></span>
      <span class="hero-orb hero-orb-c"></span>
      <span class="hero-grid"></span>
      <img
        class="hero-world-map"
        src="/assets/hero-world-map.svg?v=3"
        alt=""
        width="1000"
        height="394"
        decoding="async"
        fetchpriority="high"
      />
      <div class="world-wash world-wash-back">VISITED</div>
      <div class="world-wash">VISITED</div>
      <div class="map-progress" aria-hidden="true">
        <span>42%</span>
        <em>{ja ? "世界の訪問率" : "of the world"}</em>
      </div>
    </div>
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">VISITED PLACES</p>
      <h1>
        {ja ? (
          <>訪れた場所を塗って、<br />進捗が見える地図をつくろう。</>
        ) : (
          <>Colour the places you’ve been.<br />Watch the map fill in.</>
        )}
      </h1>
      <p>
        {ja ? (
          <>
            Colorviaは、訪れた国を選び、地図を塗ることに集中したアプリです。<br />
            対応している国では都道府県や州まで残せます。<br />
            旅の物語ではなく、訪問のコレクションと進捗が主役です。
          </>
        ) : (
          <>
            Colorvia is focused on marking visited places and colouring the map.
            <br />
            In supported countries, go deeper with states, prefectures and provinces.
            <br />
            Not a travel journal — a collection of places, and the progress of filling them in.
          </>
        )}
      </p>
      <div class="hero-actions">
        <a class="hero-cta hero-cta-primary" href={appStoreHref} target="_blank" rel="noopener noreferrer">
          <span class="hero-cta-dot" aria-hidden="true"></span>
          <span>{storeLabel}</span>
        </a>
        <a class="hero-cta hero-cta-secondary" href={`${base}/features`}>
          <span>{ja ? "機能を見る" : "Explore features"}</span>
          <span class="hero-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <small>{ja ? "iPhone・iOS 18以降向け。iPad専用レイアウトは未対応です。" : "Designed for iPhone on iOS 18+. No iPad-optimized layout yet."}</small>
    </div>
    <div class="hero-phone" data-reveal>
      <PhoneFrame size="lg">
        <picture>
          <source srcset={homeImg} type="image/webp" />
          <img
            src={homeImgPng}
            alt={ja ? "Colorviaのホーム画面。世界地図と訪問統計" : "Colorvia home screen with world map and visit stats"}
            width="1206"
            height="2622"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </PhoneFrame>
    </div>
    <AppHeroChrome
      lang={lang}
      date="2026-08-01"
      news={ja ? "Colorvia公式ブランドサイトを公開しました" : "The official Colorvia brand site is now live"}
      newsHref={`${base}/news`}
    />
  </section>

  <div class="landing-sections">
    <section class="landing-pad features" id="features">
      <header class="section-title" data-reveal>
        <h2>{ja ? "Colorviaの主な魅力" : "What makes Colorvia special"}</h2>
        <p>{ja ? "国から、その先の地域まで。旅の記録を静かに積み重ねます。" : "From countries to regions—quietly build a record of your travels."}</p>
      </header>
      <div class="feature-grid">
        {features.map(([icon, title, body]) => (
          <article data-reveal>
            <i>{icon}</i>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <a class="section-link" href={`${base}/features`}>{ja ? "すべての機能を見る" : "View all features"} →</a>
    </section>

    <section class="regions-section-band" id="regions">
      <div class="landing-pad regions-section">
        <header class="section-title regions-section-title" data-reveal>
          <p class="regions-section-eyebrow">{ja ? "国の中まで" : "GO DEEPER"}</p>
          <h2>{ja ? "国の中まで、旅を残せる。" : "Go beyond countries."}</h2>
          <p>
            {ja
              ? "対応している国では、都道府県、州、県、連邦直轄領、旅行エリアなど、国の中で訪れた地域まで記録できます。都市名や地名から該当する地域を検索することもできます。"
              : "In supported countries, record states, prefectures, provinces, federal territories and travel areas. Search by city or place name to find the right region."}
          </p>
          <dl class="regions-section-stats" data-reveal>
            <div>
              <dt>{ja ? "対応国" : "Countries"}</dt>
              <dd>{regions.length}</dd>
            </div>
            <div>
              <dt>{ja ? "記録できる地域数" : "Regions in total"}</dt>
              <dd>{regions.reduce((total, region) => total + region.count, 0)}+</dd>
            </div>
          </dl>
        </header>
        <div class="region-slideshow" data-reveal data-region-slideshow>
          <div class="region-slideshow-fade region-slideshow-fade-left" aria-hidden="true"></div>
          <div class="region-slideshow-fade region-slideshow-fade-right" aria-hidden="true"></div>
          {/* Two identical copy containers, each owning its own inter-card
              gaps AND one trailing gap, so the marquee's translateX(-50%)
              lands exactly one copy-width later — a flat list with a shared
              flex gap left the -50% point half a gap (8px) short of the
              seam, which showed as a one-frame jump every loop. */}
          <div class="region-slideshow-track" data-region-track>
            {[0, 1].map((copy) => (
              <div class="region-slideshow-copy" aria-hidden={copy === 1 ? "true" : undefined}>
                {regions.map((r) => (
                  <a
                    class="region-card region-slide-card"
                    tabindex={copy === 1 ? -1 : undefined}
                    href={`${base}/regions/${r.code.toLowerCase()}`}
                  >
                    <span class="region-map-thumb" aria-hidden="true">
                      <img src={`/assets/regions/${r.code.toLowerCase()}-regions.svg`} alt="" loading="lazy" decoding="async" />
                    </span>
                    <span class="region-flag" aria-hidden="true">{r.flag}</span>
                    <h3>{ja ? r.nameJa : r.nameEn}</h3>
                    <p class="region-unit">{ja ? r.unitJa : r.unitEn}</p>
                    <p class="region-count">{ja ? `${r.count} 地域` : `${r.count} regions`}</p>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
        <p class="region-disclaimer" data-reveal>
          {ja
            ? "Colorviaの地図や地域区分は、旅の記録を目的として簡略化・整理されています。政治的な立場や主張を示すものではありません。"
            : "Maps and regional divisions in Colorvia are simplified for travel logging and do not express a political position."}
        </p>
        <a class="section-link" href={`${base}/regions`}>{ja ? "地域マップの詳細" : "Regional maps in detail"} →</a>
      </div>
    </section>

    <section class="landing-pad how" id="how">
      <header class="section-title" data-reveal>
        <h2>{ja ? "使い方は、シンプル" : "Simple to start"}</h2>
      </header>
      <div class="step-grid">
        {steps.map(([n, title, body]) => (
          <article data-reveal>
            <span class="step-number" aria-hidden="true">{n}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <a class="section-link" href={`${base}/how-to`}>{ja ? "詳しい使い方" : "Full how-to"} →</a>
    </section>

    <section class="landing-pad lang-note" data-reveal>
      <h2>{ja ? "11言語に対応" : "Eleven languages"}</h2>
      <p>{ja ? languagesJa : languagesEn}</p>
    </section>

    <section class="landing-pad screenshots" id="screenshots">
      <header class="section-title" data-reveal>
        <h2>{ja ? "スクリーンショット" : "Screenshots"}</h2>
        <p>{ja ? "実際のアプリ画面です。" : "Real screens from the app."}</p>
      </header>
      <div class="screen-grid real-shots">
        <div class="shot-item" data-reveal>
          <PhoneFrame size="md" label={ja ? "世界地図と訪問統計" : "World map and visit stats"}>
            <picture>
              <source srcset="/assets/colorvia-home.webp" type="image/webp" />
              <img src="/assets/colorvia-home.png" alt={ja ? "世界地図ホーム画面" : "World map home screen"} width="1206" height="2622" loading="lazy" decoding="async" />
            </picture>
          </PhoneFrame>
        </div>
        <div class="shot-item" data-reveal>
          <PhoneFrame size="md" label={ja ? "訪問数と地域別の内訳" : "Counts and regional breakdown"}>
            <picture>
              <source srcset="/assets/colorvia-home-bottom-sheet.webp" type="image/webp" />
              <img src="/assets/colorvia-home-bottom-sheet.png" alt={ja ? "統計ボトムシート" : "Statistics bottom sheet"} width="1206" height="2622" loading="lazy" decoding="async" />
            </picture>
          </PhoneFrame>
        </div>
        <div class="shot-item" data-reveal>
          <PhoneFrame size="md" label={ja ? "地図色の変更" : "Custom map colours"}>
            <picture>
              <source srcset="/assets/colorvia-map-coral.webp" type="image/webp" />
              <img src="/assets/colorvia-map-coral.png" alt={ja ? "地図色を変えた画面" : "Map with custom colour"} width="1206" height="2622" loading="lazy" decoding="async" />
            </picture>
          </PhoneFrame>
        </div>
        <div class="shot-item" data-reveal>
          <PhoneFrame size="md" label={ja ? "ダークテーマ" : "Dark theme"}>
            <picture>
              <source srcset="/assets/colorvia-home-dark.webp" type="image/webp" />
              <img src="/assets/colorvia-home-dark.png" alt={ja ? "ダークテーマのホーム" : "Home in dark theme"} width="1206" height="2622" loading="lazy" decoding="async" />
            </picture>
          </PhoneFrame>
        </div>
      </div>
    </section>

    <section class="landing-pad faq" id="faq">
      <header class="section-title" data-reveal>
        <h2>{ja ? "よくある質問" : "Frequently asked questions"}</h2>
      </header>
      <div class="faq-list">
        {faqs.map(([q, a], i) => (
          <details open={i === 0} data-reveal>
            <summary>{q}<span>⌄</span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <a class="section-link" href={`${base}/faq`}>{ja ? "すべての質問を見る" : "View all questions"} →</a>
    </section>

    <section class="download-cta" id="download" data-reveal>
      <div>
        <h2>{ja ? "さあ、世界を彩ろう。" : "Colour your world."}</h2>
        <p>
          {ja
            ? "Colorviaは App Storeで配信中です。基本機能は無料。一部端末ではバナー広告が表示されます。"
            : "Colorvia is available now on the App Store. Core features are free; a banner ad may appear on some devices."}
        </p>
        <a class="store-button light" href={appStoreHref} target="_blank" rel="noopener noreferrer">● <span>{storeLabel}</span></a>
      </div>
      <div class="cta-phone">
        <PhoneFrame size="md">
          <picture>
            <source srcset={homeImg} type="image/webp" />
            <img src={homeImgPng} alt="" width="1206" height="2622" loading="lazy" decoding="async" />
          </picture>
        </PhoneFrame>
      </div>
    </section>
  </div>
</AppShell>

<script is:inline>
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const bindRegionSlideshow = () => {
      document.querySelectorAll("[data-region-slideshow]").forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
        root.dataset.bound = "1";
        if (reduce) {
          root.classList.add("is-static");
          return;
        }
        root.classList.add("is-animated");
      });
    };
    document.addEventListener("astro:page-load", bindRegionSlideshow);
    bindRegionSlideshow();
  })();
</script>
