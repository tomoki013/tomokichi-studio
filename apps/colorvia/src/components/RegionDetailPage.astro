---
import { supportUrl } from "@tomokichi/app-site/urls";
import { type Locale, type RegionCard, regionSlug, regions } from "../lib/content";
import { getRegionGuide } from "../lib/region-guides";
import "../styles/region-guide.css";
import AppShell from "./AppShell.astro";

const { lang, region } = Astro.props as { lang: Locale; region: RegionCard };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const slug = regionSlug(region.code);
const guide = getRegionGuide(region.code, lang);
const supportHref = supportUrl("colorvia", lang);
const appStoreHref = "https://apps.apple.com/app/id6798378768";
const storeLabel = ja ? "App Storeでダウンロード" : "Download on the App Store";
const name = ja ? region.nameJa : region.nameEn;

const idx = regions.findIndex((r) => r.code === region.code);
const prev = regions[(idx - 1 + regions.length) % regions.length];
const next = regions[(idx + 1) % regions.length];
const regionHref = (r: RegionCard) => `${base}/regions/${regionSlug(r.code)}`;

const faqJsonLd = guide.faq.map((item) => ({
  "@type": "Question",
  name: item.question,
  acceptedAnswer: {
    "@type": "Answer",
    text: item.answer,
  },
}));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: guide.title,
      description: guide.description,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqJsonLd,
    },
  ],
});
---

<AppShell
  lang={lang}
  title={guide.title}
  description={guide.description}
  page={`regions/${slug}`}
  jsonLd={jsonLd}
>
  <main class="content-page region-detail-page region-guide-page">
    <nav class="region-detail-crumbs" aria-label={ja ? "パンくずリスト" : "Breadcrumb"}>
      <a href={`${base}/regions`}>{ja ? "地域マップ" : "Regional maps"}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>

    <header class="region-guide-hero" data-reveal>
      <div class="region-guide-heading">
        <span class="region-guide-flag" aria-hidden="true">{region.flag}</span>
        <p class="content-eyebrow">{ja ? "地域ガイド" : "REGION GUIDE"}</p>
        <h1>{guide.title}</h1>
        <p class="region-guide-answer">{guide.answer}</p>
      </div>

      <figure class="region-guide-figure">
        <img
          class="region-guide-map"
          src={`/assets/regions/${slug}-regions.svg`}
          alt={ja
            ? `${name}でColorviaが記録する地域区分の地図`
            : `Map of the regional areas Colorvia tracks in ${name}`}
          width="1000"
          height="1000"
          loading="eager"
          decoding="async"
        />
        <figcaption class="region-guide-figcap">
          {ja
            ? "地域の位置関係を確認するための簡略図です。"
            : "A simplified map for understanding the areas and their relative locations."}
        </figcaption>
      </figure>
    </header>

    <dl class="region-guide-facts" aria-label={ja ? "基本情報" : "Quick facts"} data-reveal>
      {guide.facts.map((fact) => (
        <div class="region-guide-fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>

    <section class="region-guide-directory" data-reveal>
      <h2>{guide.directoryHeading}</h2>
      <p class="region-guide-directory-lead">{guide.directoryLead}</p>
      <div class="region-guide-table-wrap">
        <table class="region-guide-table">
          <thead>
            <tr>
              <th>{ja ? "地域名" : "Area"}</th>
              <th>{ja ? "英語・現地表記" : "Local / alternate name"}</th>
              <th>{ja ? "区分・コード" : "Type / code"}</th>
            </tr>
          </thead>
          <tbody>
            {guide.directory.map((item) => {
              const primary = ja ? (item.ja ?? item.en) : item.en;
              const secondary = ja
                ? item.en !== primary
                  ? item.en
                  : "—"
                : item.ja && item.ja !== item.en
                  ? item.ja
                  : "—";
              const meta = ja ? item.metaJa : item.metaEn;
              return (
                <tr>
                  <td class="region-guide-table-primary">{primary}</td>
                  <td class="region-guide-table-secondary">{secondary}</td>
                  <td>{meta ?? "—"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    {guide.sections.map((section) => (
      <section class="region-guide-section" data-reveal>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && (
          <ul>
            {section.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        )}
      </section>
    ))}

    <section class="region-guide-faq" data-reveal>
      <h2>{ja ? `${name}の地域についてよくある質問` : `Common questions about ${name}'s regions`}</h2>
      <dl>
        {guide.faq.map((item) => (
          <div class="region-guide-faq-item">
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="region-guide-sources" data-reveal>
      <h2>{guide.sourceLabel}</h2>
      <ul>
        {guide.sources.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="region-guide-disclaimer">
        {ja
          ? "行政区分・地域数は公的機関の情報を基準に整理しています。Colorvia独自の旅行エリアを使用する場合は本文内で明示しています。地図は旅の記録向けに簡略化され、政治的な立場や主張を示すものではありません。"
          : "Administrative structures and counts are based on public-authority sources. Where Colorvia uses its own travel areas, this is stated explicitly. Maps are simplified for travel logging and do not express a political position."}
      </p>
    </section>

    <section class="region-guide-app-cta" data-reveal>
      <h2>{guide.ctaHeading}</h2>
      <p>{guide.ctaBody}</p>
      <a class="store-button" href={appStoreHref} target="_blank" rel="noopener noreferrer">
        ● <span>{storeLabel}</span>
      </a>
    </section>

    <nav class="region-detail-pager" aria-label={ja ? "他の国" : "Other countries"}>
      <a href={regionHref(prev)}>
        <span class="region-detail-pager-dir">← {ja ? "前の国" : "Previous"}</span>
        <span class="region-detail-pager-name">{prev.flag} {ja ? prev.nameJa : prev.nameEn}</span>
      </a>
      <a href={`${base}/regions`} class="region-detail-pager-all">
        {ja ? "すべての国を見る" : "All countries"}
      </a>
      <a href={regionHref(next)}>
        <span class="region-detail-pager-dir">{ja ? "次の国" : "Next"} →</span>
        <span class="region-detail-pager-name">{next.flag} {ja ? next.nameJa : next.nameEn}</span>
      </a>
    </nav>

    <section class="region-detail-others" aria-label={ja ? "対応国一覧" : "All supported countries"}>
      <h2>{ja ? "ほかの対応国" : "Every supported country"}</h2>
      <div class="region-detail-others-grid">
        {regions.map((r) => (
          <a
            class:list={["region-detail-other", r.code === region.code && "is-current"]}
            href={regionHref(r)}
            aria-current={r.code === region.code ? "page" : undefined}
            data-astro-prefetch
          >
            <span class="region-flag" aria-hidden="true">{r.flag}</span>
            <span class="region-detail-other-name">{ja ? r.nameJa : r.nameEn}</span>
            <span class="region-detail-other-count">{r.count}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="content-cta">
      <a class="section-link" href={supportHref} target="_blank" rel="noopener noreferrer">
        {ja ? "掲載内容について問い合わせる" : "Contact us about this guide"} →
      </a>
    </div>
  </main>
</AppShell>
