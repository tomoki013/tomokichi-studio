{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomokichi-colorvia",
  "compatibility_date": "2026-07-23",
  "preview_urls": true,
  "main": "../../packages/app-site/src/asset-cache-worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    "APPLE_APP_ID": "7GU925RQ99.io.tmkch.colorvia",
    "APP_STORE_URL": "https://apps.apple.com/app/id6798378768",
    "UNIVERSAL_LINK_PATHS": "[\"/open\"]"
  }
}
