---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import { appApplicationGraph, jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import { appSiteUrl } from "@tomokichi/app-site/urls";
import AppScreen from "./AppScreen.astro";
import Shell from "./Shell.astro";

type Locale = "ja" | "en";
const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const c = ja
  ? {
      title: "Tripory",
      tagline: "旅そのものを、記憶として残す。",
      intro:
        "国を塗るだけのアプリではありません。\n写真・タイムライン・メモで、旅の過程をあとから辿れるようにします。",
      features: "旅を残す方法",
      featureLink: "すべての機能を見る",
      screenshots: "旅の記録",
      shotLink: "スクリーンショットを見る",
      cta: "次の旅から、残してみる。",
      ctaSub: "Triporyは現在、App Store公開準備中です。iPhone・iOS 26以降向け。",
      notice: "Tripory公式ブランドサイトを公開しました",
    }
  : {
      title: "Tripory",
      tagline: "Keep the journey as memory.",
      intro:
        "Not an app for colouring countries alone.\nKeep photos, timeline and notes so the trip itself remains traceable later.",
      features: "Ways to keep a journey",
      featureLink: "View all features",
      screenshots: "How a trip looks",
      shotLink: "View screenshots",
      cta: "Start with the next journey.",
      ctaSub: "Tripory is preparing for the App Store. iPhone, iOS 26 or later.",
      notice: "The official Tripory brand site is now live",
    };
const features = ja
  ? [
      ["旅のタイムライン", "出発から帰着まで、旅の流れを時系列で振り返る", "/assets/mountain-lake.png"],
      ["思い出の写真", "その日の光や風景を、旅の記録に添える", "/assets/venice.png"],
      ["場所とメモ", "旅ごとに行き先の国と、そのときの一言を残す", "/assets/iceland.png"],
      ["地図で眺める", "訪れた国と行きたい国を、地球儀や地図で見返す", "/assets/world-globe.png"],
    ]
  : [
      ["Travel timeline", "Look back on the flow of a trip from start to return", "/assets/mountain-lake.png"],
      ["Memory photos", "Attach the light and scenery of each day to the record", "/assets/venice.png"],
      ["Places & notes", "Keep the countries on a trip, plus a short note from that stretch of time", "/assets/iceland.png"],
      ["See it on a map", "Look back at visited and want-to-go countries on a globe or map", "/assets/world-globe.png"],
    ];
const journey = ja
  ? [
      ["01.18", "Reykjavík"],
      ["03.04", "Lisboa"],
      ["04.22", "Marrakech"],
      ["06.09", "Venezia"],
      ["08.14", "Cape Town"],
      ["10.02", "Cusco"],
      ["11.19", "Sydney"],
    ]
  : [
      ["01.18", "Reykjavík"],
      ["03.04", "Lisbon"],
      ["04.22", "Marrakech"],
      ["06.09", "Venice"],
      ["08.14", "Cape Town"],
      ["10.02", "Cusco"],
      ["11.19", "Sydney"],
    ];

const description = ja
  ? "Triporyは、写真・タイムライン・メモで旅そのものを記憶として残すiPhoneアプリです。現在App Store公開準備中。"
  : "Tripory keeps the journey itself — photos, timeline and notes — as memory you can revisit. Preparing for the App Store.";

/* Preparing for the App Store, so no offers and no downloadUrl: the page says
   "coming soon", and the structured data has to agree. */
const jsonLd = serializeJsonLd(
  appApplicationGraph({
    siteUrl: appSiteUrl("tripory"),
    name: "Tripory",
    description,
    applicationCategory: "TravelApplication",
    operatingSystem: "iOS 26 or later",
    path: base || "/",
    image: "/assets/cappadocia.png",
  }),
);
---

<Shell lang={lang} title={`${c.title} — ${c.tagline}`} description={description} jsonLd={jsonLd}>
  <section class="new-home tripory-hero">
    <img class="home-sky" src="/assets/cappadocia.png" alt="" />
    <div class="hero-editorial">
      <div class="home-copy">
        <p class="eyebrow">TRAVEL MEMORY</p>
        <h1>{c.tagline}</h1>
        <p>{c.intro.split("\n").map((line) => <>{line}<br /></>)}</p>
        <span class="store-soon download-badge desktop-hero-store" aria-disabled="true">
          ●<span>{storeLabel}</span>
        </span>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <figure class="hero-photo">
          <img src="/assets/venice.png" alt="" />
          <figcaption>{ja ? "旅の一枚" : "A frame from the trip"}</figcaption>
        </figure>
        <AppScreen lang={lang} size="xl" priority class="home-phone" />
        <div class="journey-rail">
          <div class="journey-track">
            {[0, 1].map((group) => (
              <div class="journey-loop" aria-hidden={group === 1}>
                {journey.map(([date, city]) => (
                  <span class="journey-stop">
                    <em>{date}</em>
                    <strong>{city}</strong>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="mobile-hero-actions">
        <span class="store-soon download-badge" aria-disabled="true">●<span>{storeLabel}</span></span>
        <a href={`${base}/features`}>{ja ? "機能を見る" : "Explore features"} →</a>
      </div>
    </div>
    <AppHeroChrome lang={lang} date="2026-07-24" news={c.notice} newsHref={`${base}/news`} />
  </section>

  <section class="home-section" data-reveal>
    <div class="section-bar"><h2>{c.features}</h2><a href={`${base}/features`}>{c.featureLink}　→</a></div>
    <div class="home-features feature-editorial-grid">
      {features.map(([title, body, image], i) => (
        <article class:list={{ dark: i === 0 || i === 3 }} data-reveal>
          <img src={image} alt="" />
          <div><h3>{title}</h3><p>{body}</p></div>
          <a href={`${base}/features`}>→</a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section screenshots-section" data-reveal>
    <div class="section-bar"><h2>{c.screenshots}</h2><a href={`${base}/screenshots`}>{c.shotLink}　→</a></div>
    <div class="real-screen-feature">
      <AppScreen lang={lang} size="lg" class="real-screen-phone" />
      <div class="real-screen-copy" data-reveal>
        <p class="eyebrow">REAL APP CAPTURE</p>
        <h3>{ja ? "旅の入口は、あなたの世界。" : "Your world is where every trip begins."}</h3>
        <p>{ja ? "実際のTriporyの画面です。訪れた国、写真、次の旅への入口がひとつの画面につながります。" : "This is the real Tripory screen. Visited countries, photographs, and the next journey meet in one place."}</p>
        <a href={`${base}/screenshots`}>{ja ? "実際の画面を大きく見る" : "See the real screen in detail"} →</a>
      </div>
    </div>
  </section>

  <section class="home-section tripory-promise" data-reveal>
    <div class="promise-image"><img src="/assets/morocco.png" alt="" /></div>
    <div class="promise-copy">
      <p class="eyebrow">PRIVATE BY DESIGN</p>
      <h2>{ja ? "思い出は、あなたの手元に。" : "Your memories stay with you."}</h2>
      <p>{ja ? "アカウント登録は不要。旅の記録は端末内に保存され、選んだ写真だけを扱います。無料版ではバナー広告と、新しい国を初めて記録したあとにインタースティシャル広告が出ることがあります。買い切りの「広告を削除」で非表示にできます。" : "No account is required. Trip records stay on your device, and the app only handles photographs you select. The free version may show banner ads, and occasionally an interstitial after you first log a new country. A one-time Remove Ads purchase hides them."}</p>
      <a href={`${base}/privacy`}>{ja ? "プライバシーポリシーを読む" : "Read the privacy policy"} →</a>
    </div>
  </section>

  <section class="tripory-cta" id="download" data-reveal>
    <img src="/assets/mountain-lake.png" alt="" />
    <div><h2>{c.cta}</h2><p>{c.ctaSub}</p></div>
    <div class="store-row">
      <span class="store-soon" aria-disabled="true">●　{storeLabel}</span>
    </div>
  </section>
</Shell>
