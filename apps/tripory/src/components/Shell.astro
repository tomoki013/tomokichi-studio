---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";
import { appSiteUrl, mainSiteUrl, supportUrl } from "@tomokichi/app-site/urls";

type Locale = "ja" | "en";
const { lang, title, page = "", routePath = page, description, jsonLd = "", noindex = false } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  /** Route used for canonical and hreflang, when it differs from `page`. */
  routePath?: string;
  description?: string;
  jsonLd?: string;
  noindex?: boolean;
};
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${routePath}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${routePath}`.replace(/\/$/, "") || "/";
const nav = ja
  ? [
      { slug: "features", label: "機能紹介", href: href("features") },
      { slug: "how-to", label: "使い方", href: href("how-to") },
      { slug: "screenshots", label: "スクリーンショット", href: href("screenshots") },
    ]
  : [
      { slug: "features", label: "Features", href: href("features") },
      { slug: "how-to", label: "How to", href: href("how-to") },
      { slug: "screenshots", label: "Screenshots", href: href("screenshots") },
    ];
const supportHref = supportUrl("tripory", lang);
const footerColumns = ja
  ? [
      { title: "プロダクト", links: [{ label: "機能紹介", href: href("features") }, { label: "使い方", href: href("how-to") }, { label: "スクリーンショット", href: href("screenshots") }] },
      { title: "サポート", links: [{ label: "よくある質問", href: href("faq") }, { label: "ニュース", href: href("news") }, { label: "アップデート情報", href: href("updates") }, { label: "お問い合わせ", href: supportHref, external: true }] },
      { title: "規約", links: [{ label: "プライバシーポリシー", href: href("privacy") }, { label: "利用規約", href: href("terms") }, { label: "特定商取引法に基づく表記", href: href("commercial-transactions") }] },
      { title: "運営者情報", links: [{ label: "運営サイト", href: mainSiteUrl("ja"), external: true }, { label: "ほかのアプリ", href: mainSiteUrl("ja", "/products"), external: true }] },
    ]
  : [
      { title: "Product", links: [{ label: "Features", href: href("features") }, { label: "How to", href: href("how-to") }, { label: "Screenshots", href: href("screenshots") }] },
      { title: "Support", links: [{ label: "FAQ", href: href("faq") }, { label: "News", href: href("news") }, { label: "App updates", href: href("updates") }, { label: "Contact", href: supportHref, external: true }] },
      { title: "Legal", links: [{ label: "Privacy Policy", href: href("privacy") }, { label: "Terms of Service", href: href("terms") }, { label: "Commercial Transactions", href: href("commercial-transactions") }] },
      { title: "Operator", links: [{ label: "Operator site", href: mainSiteUrl("en"), external: true }, { label: "Other apps", href: mainSiteUrl("en", "/products"), external: true }] },
    ];
const metaDescription = description ?? (ja
  ? "Triporyは、写真・タイムライン・メモで旅そのものを記憶として残すiPhoneアプリです。現在App Store公開準備中。"
  : "Tripory keeps the journey itself — photos, timeline and notes — as memory you can revisit. Preparing for the App Store.");
---

<AppSiteShell
  lang={lang}
  title={title}
  description={metaDescription}
  page={page}
  brand="TRIPORY"
  logoImage="/assets/tripory-icon.png"
  ogImage="/assets/cappadocia.png"
  tagline={ja ? "旅そのものを、記憶として残す。" : "Keep the journey as memory."}
  siteUrl={appSiteUrl("tripory")}
  homeHref={ja ? "/ja" : "/"}
  jaPageHref={jaPageHref}
  enPageHref={enPageHref}
  nav={nav}
  footerColumns={footerColumns}
  appStoreLabel={ja ? "App Storeで近日公開" : "Coming soon on the App Store"}
  appStoreHref=""
  appStoreComingSoon
  menuLabel={ja ? "メニュー" : "Menu"}
  pageClass={`tripory-page${page ? " tripory-subpage" : ""}`}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <slot />
  <script is:inline>
    document.querySelectorAll("[data-reveal]").forEach((item, index) => {
      item.style.setProperty("--delay", `${(index % 5) * 55}ms`);
    });
  </script>
</AppSiteShell>
