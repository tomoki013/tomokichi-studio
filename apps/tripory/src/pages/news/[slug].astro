---
import NewsArticlePage from "@tomokichi/app-site/NewsArticlePage.astro";
import Shell from "../../components/Shell.astro";
import { getNewsPosts } from "../../lib/news";
import "../../styles/global.css";

export function getStaticPaths() {
  return getNewsPosts("en").map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: ReturnType<typeof getNewsPosts>[number] };
---

<Shell lang="en" title={post.title} description={post.summary} page="news" routePath={`news/${post.id}`}>
  <NewsArticlePage post={post} lang="en" backHref="/news" />
</Shell>
