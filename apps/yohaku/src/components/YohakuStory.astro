---
/**
 * Yohaku's take on the shared scroll story: copy comes from the caller and
 * every beat's visual is a real capture in the shared phone frame.
 */

import AppSimpleSteps from "@tomokichi/app-site/AppSimpleSteps.astro";
import AppStory, { type StoryStep } from "@tomokichi/app-site/AppStory.astro";
import StoryVisual, { type StoryScreen } from "./StoryVisual.astro";

export type { StoryScreen };

export type YohakuStep = Omit<StoryStep, "visual"> & {
  screen?: StoryScreen;
  /** Shows the light and dark captures side by side instead of one screen. */
  appearance?: boolean;
};

const {
  lang,
  heading = "",
  lead = "",
  steps,
  /** "scroll" (default) pins/parallaxes via AppStory; "simple" just fades in — used for how-to. */
  variant = "scroll",
  class: className = "",
} = Astro.props as {
  lang: "ja" | "en";
  heading?: string;
  lead?: string;
  steps: YohakuStep[];
  variant?: "scroll" | "simple";
  class?: string;
};

const storySteps: StoryStep[] = steps.map((step) => ({
  ...step,
  visual: { lang, screen: step.screen, appearance: step.appearance },
}));

const Story = variant === "simple" ? AppSimpleSteps : AppStory;
---

<Story
  heading={heading}
  lead={lead}
  steps={storySteps}
  visual={StoryVisual}
  class:list={["yohaku-story", className]}
>
  <slot />
</Story>
