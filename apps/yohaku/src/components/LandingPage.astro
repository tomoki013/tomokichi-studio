---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import { appApplicationGraph, jsonLd as serializeJsonLd } from "@tomokichi/app-site/seo";
import { appSiteUrl } from "@tomokichi/app-site/urls";
import AppScreen from "./AppScreen.astro";
import AppShell from "./AppShell.astro";
import FeatureStory from "./FeatureStory.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const appStoreHref = "https://apps.apple.com/app/id6798718923";
const storeLabel = ja ? "App Storeでダウンロード" : "Download on the App Store";

const description = ja
  ? "Yohakuは、日々の中に何もしない時間を置き、今日・週・月で静かに振り返るためのiPhoneアプリです。App Storeで配信中。"
  : "Yohaku is an iPhone app for leaving time with nothing planned, then looking back across your day, week and month. Available now on the App Store.";

const jsonLd = serializeJsonLd(
  appApplicationGraph({
    siteUrl: appSiteUrl("yohaku"),
    name: "Yohaku",
    description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS 17.0 or later",
    path: base || "/",
    image: "/og.jpg",
    appStoreUrl: "https://apps.apple.com/app/id6798718923",
  }),
);
---

<AppShell
  lang={lang}
  title={ja ? "余白を置く、小さな習慣を。" : "Leave room. Keep it small."}
  description={description}
  jsonLd={jsonLd}
>
  <section class="yohaku-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>{ja ? <>余白を置く。</> : <>Leave room.</>}</h1>
        <p class="hero-lead">{ja ? "予定ではなく、余白だけを。" : "Not another plan. Just space."}</p>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-body">
          {ja
            ? "何もしない時間を、今日に置く。それだけ。"
            : "Leave time with nothing planned. That is enough."}
        </p>
        <p class="hero-body">
          {ja
            ? "Yohakuは、何もしない時間に名前と開始・終了時刻をつけて置き、今日・週・月で振り返るiPhoneアプリです。"
            : "Yohaku is an iPhone app for giving unplanned time a name, a start and an end, then looking back across your day, week and month."}
        </p>
        <div class="hero-actions">
          <a class="store-button" href={appStoreHref} target="_blank" rel="noopener noreferrer">
            <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
            {storeLabel}
          </a>
          <a class="secondary-button" href={`${base}/features`}>{ja ? "詳しく見る" : "Learn more"}</a>
        </div>
      </div>

      <section class="hero-devices" aria-label={ja ? "YohakuのToday画面" : "Yohaku Today screen"}>
        <figure class="hero-device hero-device-single">
          <figcaption>{ja ? "今日" : "Today"}</figcaption>
          <AppScreen screen="today" size="lg" lang={lang} priority />
        </figure>
      </section>
    </div>

    <AppHeroChrome
      lang={lang}
      date="2026-08-17"
      news={ja ? "Yohakuを、App Storeでリリースしました" : "Yohaku is now available on the App Store"}
      newsHref={`${base}/news`}
    />
  </section>

  <FeatureStory lang={lang} />

  <section class="yohaku-principles section-pad" aria-labelledby="principles-title">
    <div class="principles-intro">
      <p class="content-eyebrow">PHILOSOPHY</p>
      <h2 id="principles-title">{ja ? <>余白を、<br />成果にしない。</> : <>Space is not<br />another achievement.</>}</h2>
      <p>{ja
        ? "続けることも、埋めることも、うまく休むことも求めません。Yohakuは、何もしない時間を置いて、あとから静かに眺めるための道具です。"
        : "No streaks to maintain, gaps to fill, or perfect way to rest. Yohaku is simply a place to leave time open and look back quietly."}</p>
    </div>
    <ol class="principles-list">
      <li><span>01</span><div><h3>{ja ? "競わない" : "No competition"}</h3><p>{ja ? "連続記録や達成率はありません。" : "No streaks or completion scores."}</p></div></li>
      <li><span>02</span><div><h3>{ja ? "急かさない" : "No pressure"}</h3><p>{ja ? "余白が始まる少し前に、そっと一度。" : "One quiet notice just before a space begins."}</p></div></li>
      <li><span>03</span><div><h3>{ja ? "外へ出さない" : "Stays with you"}</h3><p>{ja ? "記録はアカウントなしで端末の中に。" : "No account. Your spaces stay on-device."}</p></div></li>
    </ol>
  </section>

  <section class="yohaku-pause" aria-label={ja ? "Yohakuの考え方" : "Yohaku’s approach"}>
    <span aria-hidden="true">□</span>
    <p>{ja ? <>予定を増やすのではなく、<br />予定のない時間を置く。</> : <>Do not add another plan.<br />Leave time without one.</>}</p>
  </section>

  <section class="pricing-teaser section-pad" data-reveal>
    <header class="section-heading">
      <h2>{ja ? "基本機能は、すべて無料です。" : "Every core feature is free."}</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </header>
    <p class="pricing-teaser-body">
      {ja
        ? "無料版には控えめなバナー広告が表示される場合があります。一度きりの「広告を永久に削除」で、広告を非表示にできます。サブスクリプションではありません。"
        : "The free version may show unobtrusive banner ads. A one-time “Remove ads permanently” purchase removes ads. It is not a subscription."}
    </p>
    <a class="text-link" href={`${base}/pricing`}>{ja ? "料金について詳しく" : "About pricing"} →</a>
  </section>

  <section class="download-section" id="download" data-reveal>
    <h2>{ja ? "余白を置く、小さな習慣を。" : "Leave room. Keep it small."}</h2>
    <p class="download-note">
      {ja
        ? "iPhone・iOS 17以降に対応。App Storeで配信中です。"
        : "Requires an iPhone with iOS 17 or later. Available now on the App Store."}
    </p>
    <a class="store-button" href={appStoreHref} target="_blank" rel="noopener noreferrer">
      <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
      {storeLabel}
    </a>
  </section>
</AppShell>
