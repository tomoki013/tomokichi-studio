---
import type { Locale } from "../data/apps";
import { footer } from "../lib/copy";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const base = lang === "ja" ? "/ja" : "";
/* Internal paths get the locale prefix; external ones are used as-is. */
const href = (p: string, external?: boolean) => {
  if (external) return p;
  return `${base}${p === "/" ? "" : p}` || "/";
};
---

<footer class="site-footer shell">
  <div class="footer-brand">
    <a class="brand" href={lang === "ja" ? "/ja" : "/"}>
      <img src="/icon-192.png" alt="" width="26" height="26" />
      <span>Tomokichi</span>
    </a>
    <p class="f-tag">{footer.tagline[lang]}</p>
  </div>

  <div class="footer-cols">
    {footer.columns.map((col) => (
      <nav aria-label={col.title[lang]}>
        <h2>{col.title[lang]}</h2>
        {col.links.map((link) => (
          <a
            href={href(link.href, link.external)}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label[lang]}
          </a>
        ))}
      </nav>
    ))}
  </div>

  <div class="footer-base">
    <small>{footer.copyright}</small>
    <p class="made-with">Made with ♡ by Tomokichi</p>
  </div>
</footer>
