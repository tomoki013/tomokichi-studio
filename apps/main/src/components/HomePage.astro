---
import { Image } from "astro:assets";
import introduce from "../assets/introduce.jpg";
import mountainLake from "../assets/travel/mountain-lake.jpg";
import santorini from "../assets/travel/santorini.jpg";
import venice from "../assets/travel/venice.jpg";
import type { Locale } from "../data/apps";
import { developingApps, releasedApps } from "../data/apps";
import BaseLayout from "../layouts/BaseLayout.astro";
import { home, principles, principlesHeading } from "../lib/copy";
import {
  categoryLabels,
  currentEntry,
  entryHref,
  formatDate,
  journalEntries,
  recentEntries,
} from "../lib/journal";
import { homeJsonLd } from "../lib/structured-data";
import AppCard from "./AppCard.astro";
import AppScreen from "./AppScreen.astro";
import ArrowLink from "./ArrowLink.astro";
import JournalCard from "./JournalCard.astro";
import PrincipleItem from "./PrincipleItem.astro";
import SectionHeader from "./SectionHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const p = (path: string) => (ja ? `/ja${path === "/" ? "" : path}` : path);

const current = await currentEntry(lang);
const recent = await recentEntries(lang, 3);
const allEntries = await journalEntries(lang);
const available = releasedApps.slice(0, 3);
const making = developingApps.slice(0, 5);

/* The hero is the site's thesis drawn as a trail: something noticed on a trip,
   written down as a question, and finally given a form. Every station is a
   real artefact — the photos, the newest journal entry, a shipped app — and
   the mountain behind them is the same landscape the trail climbs. */
const journey = home.hero.journey;
const heroNote = current ?? recent[0];
const heroFacts = [
  { term: home.facts.based[lang], value: "Kyoto / Tokyo" },
  { term: home.facts.released[lang], value: String(releasedApps.length) },
  { term: home.facts.notes[lang], value: String(allEntries.length) },
];
---

<BaseLayout
  lang={lang}
  title={home.metaTitle[lang]}
  description={home.hero.body[lang].replaceAll("\n", " ")}
  path="/"
  jsonLd={homeJsonLd(lang)}
>
  <div class="site">
    <SiteHeader lang={lang} path="/" />

    <main>
      <section class="hero shell" data-hero>
        <div class="hero-backdrop" aria-hidden="true">
          <Image
            class="hero-backdrop-img"
            src={mountainLake}
            format="webp"
            widths={[720, 1180, 1600]}
            sizes="(max-width: 1180px) 100vw, 1180px"
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hero-copy">
          <p class="hero-eyebrow" data-reveal="fade">{home.hero.eyebrow[lang]}</p>
          <h1 data-reveal="rise" style="--reveal-i:1">{home.hero.heading[lang]}</h1>
          <div class="hero-copy-aside">
            <p class="lead" data-reveal style="--reveal-i:2">{home.hero.body[lang]}</p>
            <div class="hero-actions" data-reveal style="--reveal-i:3">
              <ArrowLink href={p("/journal")} label={home.hero.cta[lang]} />
              <ArrowLink href={p("/products")} label={home.hero.ctaSub[lang]} soft />
            </div>
            <dl class="hero-facts" data-reveal style="--reveal-i:4">
              {heroFacts.map((fact) => (
                <div>
                  <dt>{fact.term}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <section class="hero-trail" data-reveal="fade" style="--reveal-i:3" aria-labelledby="hero-trail-heading">
          <h2 class="sr-only" id="hero-trail-heading">{journey.heading[lang]}</h2>
          <svg class="hero-trail-path" viewBox="0 0 1000 380" preserveAspectRatio="none" aria-hidden="true">
            <path class="hero-trail-line" d="M 40 318 C 200 318, 250 262, 380 250 S 620 236, 720 168 S 860 40, 940 110" />
            <path class="hero-trail-draw" pathLength="1" d="M 40 318 C 200 318, 250 262, 380 250 S 620 236, 720 168 S 860 40, 940 110" />
          </svg>

          <ol class="hero-stations">
            <li class="hero-station st-notice" style="--depth:1.3">
              <div class="station-visual">
                <figure class="station-photo a">
                  <Image src={venice} format="webp" widths={[320, 520]} sizes="(max-width: 900px) 60vw, 260px" alt="" loading="eager" decoding="async" />
                </figure>
                <figure class="station-photo b">
                  <Image src={santorini} format="webp" widths={[240, 400]} sizes="(max-width: 900px) 30vw, 130px" alt="" loading="lazy" decoding="async" />
                </figure>
              </div>
              <p class="station-label"><span class="station-index">01</span>{journey.notice.label[lang]}<small>{journey.notice.note[lang]}</small></p>
            </li>

            <li class="hero-station st-write" style="--depth:0.8">
              {heroNote ? (
                <a class="station-visual station-paper" href={entryHref(heroNote, lang)}>
                  <span class="paper-meta">
                    <time datetime={heroNote.data.date.toISOString().slice(0, 10)}>{formatDate(heroNote.data.date, lang)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{categoryLabels[heroNote.data.category][lang]}</span>
                  </span>
                  <span class="paper-title">{heroNote.data.title}</span>
                  <span class="paper-arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <div class="station-visual station-paper">
                  <span class="paper-title">{journey.write.note[lang]}</span>
                </div>
              )}
              <p class="station-label"><span class="station-index">02</span>{journey.write.label[lang]}<small>{journey.write.note[lang]}</small></p>
            </li>

            <li class="hero-station st-form" style="--depth:0.45">
              <div class="station-visual">
                <AppScreen
                  class="hero-device"
                  screen="tripory-home"
                  lang={lang}
                  alt={ja ? "iPhoneで動くTripory" : "Tripory running on an iPhone"}
                  size="sm"
                />
              </div>
              <p class="station-label"><span class="station-index">03</span>{journey.form.label[lang]}<small>{journey.form.note[lang]}</small></p>
            </li>
          </ol>
        </section>

        <a class="hero-scroll" href="#home-current" aria-label={home.hero.scroll[lang]}>
          <span class="hero-scroll-line" aria-hidden="true"></span>
          <span class="hero-scroll-text" aria-hidden="true">{home.hero.scroll[lang]}</span>
        </a>
      </section>

      {current && (
        <section class="home-current shell" id="home-current" data-reveal>
          <SectionHeader title={home.currentHeading[lang]} />
          <JournalCard entry={current} lang={lang} variant="current" />
        </section>
      )}

      {recent.length > 0 && (
        <section class="home-journal shell">
          <SectionHeader
            title={home.journalHeading[lang]}
            linkHref={p("/journal")}
            linkLabel={home.journalAll[lang]}
          />
          <div class="journal-rows">
            {recent.map((entry, i) => (
              <div data-reveal style={`--reveal-i:${i}`}>
                <JournalCard entry={entry} lang={lang} />
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="home-apps shell">
        <div data-reveal>
          <SectionHeader title={home.appsHeading[lang]} linkHref={p("/products")} linkLabel={home.appsAll[lang]} />
        </div>

        {available.length > 0 && (
          <div class="home-apps-group">
            <h3 class="home-apps-label" data-reveal="fade">{home.appsAvailableHeading[lang]}</h3>
            <div class="app-grid app-grid-available">
              {available.map((app, i) => (
                <div data-reveal style={`--reveal-i:${i}`}>
                  <AppCard app={app} lang={lang} variant="compact" />
                </div>
              ))}
            </div>
          </div>
        )}

        {making.length > 0 && (
          <div class="home-apps-group">
            <h3 class="home-apps-label" data-reveal="fade">{home.appsMakingHeading[lang]}</h3>
            <div class="app-grid">
              {making.map((app, i) => (
                <div data-reveal style={`--reveal-i:${i}`}>
                  <AppCard app={app} lang={lang} variant="compact" />
                </div>
              ))}
            </div>
          </div>
        )}
      </section>

      <section class="home-approach shell">
        <div data-reveal>
          <SectionHeader title={principlesHeading[lang]} />
        </div>
        <div class="approach-grid">
          {principles.map((item, i) => (
            <div data-reveal style={`--reveal-i:${i}`}>
              <PrincipleItem title={item.title[lang]} body={item.body[lang]} index={i} />
            </div>
          ))}
        </div>
      </section>

      <section class="home-about shell">
        <div data-reveal="left">
          <h2>{home.about.heading[lang]}</h2>
          <p>{home.about.body[lang]}</p>
          <ArrowLink href={p("/about")} label={home.about.link[lang]} />
        </div>
        <figure class="photo-frame photo-frame--round" data-reveal="right">
          <Image
            src={introduce}
            format="webp"
            widths={[240, 380, 560]}
            sizes="(max-width: 900px) 46vw, 240px"
            alt={ja
              ? "旅先の高台に立つTomokichi。背後に川と丘の上の旧市街が広がっている"
              : "Tomokichi standing on a hillside while travelling, with a river and an old town on the ridge behind"}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>

      <section class="home-prefooter shell" data-reveal="rise">
        <h2>{home.prefooter.heading[lang]}</h2>
        <p>{home.prefooter.body[lang]}</p>
        <ArrowLink href={p("/products")} label={home.appsAll[lang]} />
      </section>
    </main>

    <SiteFooter lang={lang} />
  </div>
</BaseLayout>

<script>
  /*
   * The trail leans a little towards the pointer, with the nearer stations
   * moving more than the far ones. It is decoration only: touch devices and
   * anyone who asked for less motion get the static composition.
   */
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches || !matchMedia("(pointer: fine)").matches;
  if (hero && !still) {
    let frame = 0;
    let x = 0;
    let y = 0;
    const apply = () => {
      frame = 0;
      hero.style.setProperty("--mx", x.toFixed(3));
      hero.style.setProperty("--my", y.toFixed(3));
    };
    hero.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();
      x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      y = ((event.clientY - rect.top) / rect.height) * 2 - 1;
      if (!frame) frame = requestAnimationFrame(apply);
    });
    hero.addEventListener("pointerleave", () => {
      x = 0;
      y = 0;
      if (!frame) frame = requestAnimationFrame(apply);
    });
  }
</script>
