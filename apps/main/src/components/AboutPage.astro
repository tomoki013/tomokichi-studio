---
import { Image } from "astro:assets";
import { SITE_ORIGINS } from "@tomokichi/app-site/urls";
import introduce from "../assets/introduce.jpg";
import type { Locale } from "../data/apps";
import { orderedApps } from "../data/apps";
import BaseLayout from "../layouts/BaseLayout.astro";
import { about, principles, principlesHeading } from "../lib/copy";
import { aboutJsonLd } from "../lib/structured-data";
import AppIcon from "./AppIcon.astro";
import ArrowLink from "./ArrowLink.astro";
import PrincipleItem from "./PrincipleItem.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const p = (path: string) => (ja ? `/ja${path === "/" ? "" : path}` : path);

const links = {
  website: SITE_ORIGINS.personal,
  github: SITE_ORIGINS.github,
  contact: `${SITE_ORIGINS.personal}/contact`,
};
---

<BaseLayout
  lang={lang}
  title={about.metaTitle[lang]}
  description={about.metaDescription[lang]}
  path="/about"
  jsonLd={aboutJsonLd(lang)}
>
  <div class="site">
    <SiteHeader lang={lang} path="/about" current="about" />

    <main>
      <section class="about-hero shell">
        <div data-reveal="rise">
          <h1>{about.hero.heading[lang]}</h1>
          <p class="lead">{about.hero.body[lang]}</p>
        </div>
        <div class="about-shapes" aria-hidden="true">
          <span class="s beige"></span>
          <span class="s green"></span>
          <span class="square"></span>
          <span class="arch"></span>
        </div>
      </section>

      <section class="about-maker shell">
        <div data-reveal="left">
          <h2>{about.maker.heading[lang]}</h2>
          <p>{about.maker.body[lang]}</p>
        </div>
        <ul class="meta" data-reveal="right">
          <li class="loc">{about.maker.location}</li>
          <li><a href={links.website} target="_blank" rel="noopener noreferrer">{about.maker.linksLabel.website[lang]} ↗</a></li>
          <li><a href={links.github} target="_blank" rel="noopener noreferrer">{about.maker.linksLabel.github[lang]} ↗</a></li>
          <li><a href={links.contact} target="_blank" rel="noopener noreferrer">{about.maker.linksLabel.contact[lang]} ↗</a></li>
        </ul>
      </section>

      <section class="about-concept shell">
        <h2 data-reveal="fade">{about.concept.heading[lang]}</h2>
        <div class="concept-grid">
          {about.concept.items.map((item, i) => (
            <article data-reveal style={`--reveal-i:${i}`}>
              <h3>{item.title[lang]}</h3>
              <p>{item.body[lang]}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about-approach shell" id="approach">
        <h2 style="margin:0 0 6px;font:500 22px/1.3 var(--serif)" data-reveal="fade">{principlesHeading[lang]}</h2>
        <div class="approach-grid">
          {principles.map((item, i) => (
            <div data-reveal style={`--reveal-i:${i}`}>
              <PrincipleItem title={item.title[lang]} body={item.body[lang]} index={i} />
            </div>
          ))}
        </div>
      </section>

      <section class="about-now shell">
        <div data-reveal="left">
          <h2>{about.now.heading[lang]}</h2>
          <p>{about.now.body[lang]}</p>
        </div>
        <figure class="photo-frame" data-reveal="right">
          <Image
            src={introduce}
            format="webp"
            widths={[320, 480, 720]}
            sizes="(max-width: 900px) 88vw, 320px"
            alt={ja
              ? "旅先の高台に立つTomokichi。背後に川と丘の上の旧市街が広がっている"
              : "Tomokichi standing on a hillside while travelling, with a river and an old town on the ridge behind"}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{about.now.caption[lang]}</figcaption>
        </figure>
      </section>

      <section class="about-making shell">
        <h2 style="margin:0;font:500 22px/1.3 var(--serif)" data-reveal="fade">{about.making.heading[lang]}</h2>
        <div class="making-row">
          {orderedApps.map((app, i) => (
            <div class="item" data-reveal style={`--reveal-i:${i}`}><AppIcon iconClass={app.iconClass} slug={app.slug} name={app.name} size={40} /><span>{app.name}</span></div>
          ))}
        </div>
        <div class="all" data-reveal="fade"><ArrowLink href={p("/products")} label={about.making.all[lang]} /></div>
      </section>

      <section class="about-cta shell" data-reveal="rise">
        <a class="cta-card" href={p("/products")}>
          <h3>{about.bottom.apps.heading[lang]}</h3>
          <p>{about.bottom.apps.body[lang]}</p>
          <span class="arrow-link soft"><span>{about.bottom.apps.heading[lang]}</span><span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="cta-card" href={p("/support")}>
          <h3>{about.bottom.support.heading[lang]}</h3>
          <p>{about.bottom.support.body[lang]}</p>
          <span class="arrow-link soft"><span>{about.bottom.support.heading[lang]}</span><span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </section>
    </main>

    <SiteFooter lang={lang} />
  </div>
</BaseLayout>
