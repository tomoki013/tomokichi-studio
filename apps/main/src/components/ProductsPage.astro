---
import type { Locale } from "../data/apps";
import { conceptApps, developingApps, orderedApps, releasedApps } from "../data/apps";
import BaseLayout from "../layouts/BaseLayout.astro";
import { appsPage } from "../lib/copy";
import { entriesForProduct } from "../lib/journal";
import { productsJsonLd } from "../lib/structured-data";
import AppCard from "./AppCard.astro";
import ArrowLink from "./ArrowLink.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const p = (path: string) => (ja ? `/ja${path === "/" ? "" : path}` : path);

// The records a product came out of, resolved once so each card can link back.
const behindByProduct = new Map(
  await Promise.all(
    orderedApps.map(async (app) => [app.slug, await entriesForProduct(lang, app.slug)] as const),
  ),
);

const visualIcons = orderedApps.slice(0, 4).map((app) => ({
  iconClass: app.iconClass,
  accent: app.accent,
}));
---

<BaseLayout
  lang={lang}
  title={appsPage.metaTitle[lang]}
  description={appsPage.metaDescription[lang]}
  path="/products"
  jsonLd={productsJsonLd(lang)}
>
  <div class="site">
    <SiteHeader lang={lang} path="/products" current="products" />

    <main>
      <section class="apps-hero shell">
        <div data-reveal="rise">
          <h1>{appsPage.hero.heading[lang]}</h1>
          <p class="lead">{appsPage.hero.body[lang]}</p>
        </div>
        <div class="apps-visual" aria-hidden="true" data-reveal="zoom">
          {visualIcons.map((ic, i) => (
            <div
              class:list={["app-icon", ic.iconClass, `i${i + 1}`]}
              style={ic.accent ? `box-shadow: inset 0 0 0 1px rgb(0 0 0 / 5%), 0 10px 26px ${ic.accent}33` : undefined}
            >
              <span></span>
            </div>
          ))}
        </div>
      </section>

      <nav class="apps-filter shell" aria-label={ja ? "ステータスで絞り込み" : "Filter by status"} data-filter-bar>
        {appsPage.filters.map((f, i) => (
          <button type="button" data-filter={f.key} aria-current={i === 0 ? "true" : "false"}>{f.label[lang]}</button>
        ))}
      </nav>

      <div class="apps-catalogue" data-apps-list>
        <section class="apps-section shell" data-section="released" hidden={releasedApps.length === 0}>
          <header class="apps-section-head" data-reveal="fade">
            <h2>{appsPage.sections.available[lang]}</h2>
            <span class="apps-count">{releasedApps.length}</span>
          </header>
          <div class="apps-list apps-list-available">
            {releasedApps.map((app) => (
              <AppCard app={app} lang={lang} variant="large" behind={behindByProduct.get(app.slug)} />
            ))}
          </div>
        </section>

        <section class="apps-section shell" data-section="developing" hidden={developingApps.length === 0}>
          <header class="apps-section-head" data-reveal="fade">
            <h2>{appsPage.sections.developing[lang]}</h2>
            <span class="apps-count">{developingApps.length}</span>
          </header>
          <div class="apps-list apps-list-developing">
            {developingApps.map((app) => (
              <AppCard app={app} lang={lang} variant="medium" behind={behindByProduct.get(app.slug)} />
            ))}
          </div>
        </section>

        <section class="apps-section shell" data-section="concept" hidden={conceptApps.length === 0}>
          <header class="apps-section-head" data-reveal="fade">
            <h2>{appsPage.sections.concept[lang]}</h2>
            <span class="apps-count">{conceptApps.length}</span>
          </header>
          <div class="apps-list apps-list-concept">
            {conceptApps.map((app) => (
              <AppCard app={app} lang={lang} variant="medium" behind={behindByProduct.get(app.slug)} />
            ))}
          </div>
        </section>

        <p class="apps-empty shell" hidden data-empty>{ja ? "該当するアプリはありません。" : "No apps match this filter."}</p>
      </div>

      <section class="apps-support shell" data-reveal="rise">
        <h2>{appsPage.bottom.heading[lang]}</h2>
        <p>{appsPage.bottom.body[lang]}</p>
        <ArrowLink href={p("/support")} label={appsPage.bottom.cta[lang]} />
      </section>
    </main>

    <SiteFooter lang={lang} />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const bar = document.querySelector("[data-filter-bar]");
    const root = document.querySelector("[data-apps-list]");
    if (!bar || !root) return;
    const cards = Array.from(root.querySelectorAll(".app-card"));
    const sections = Array.from(root.querySelectorAll("[data-section]"));
    const empty = root.querySelector("[data-empty]");

    const apply = (key) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = key === "all" || card.getAttribute("data-status") === key;
        card.classList.toggle("is-hidden", !match);
        if (match) shown++;
      });
      sections.forEach((section) => {
        const total = section.querySelectorAll(".app-card").length;
        if (total === 0) {
          section.hidden = true;
          return;
        }
        section.hidden = section.querySelectorAll(".app-card:not(.is-hidden)").length === 0;
      });
      if (empty) empty.hidden = shown !== 0;
      bar.querySelectorAll("button").forEach((b) => {
        b.setAttribute("aria-current", String(b.getAttribute("data-filter") === key));
      });
      const url = new URL(location.href);
      if (key === "all") url.searchParams.delete("status");
      else url.searchParams.set("status", key);
      history.replaceState(null, "", url);
    };

    bar.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-filter]");
      if (btn) apply(btn.getAttribute("data-filter"));
    });

    const initial = new URL(location.href).searchParams.get("status");
    if (initial && ["released", "developing", "concept"].includes(initial)) apply(initial);
  })();
</script>
