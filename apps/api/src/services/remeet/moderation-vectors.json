      "reunionID": "6f9619ff-8b86-d011-b42d-00cf4fc964ff",
      "field": "sharedGroupDisplayName",
      "value": "違反表現",
      "expected": "u2QqsTTWuxbcogmYq7GzcBDCACEogS5I35yh5DhALvg"
    },
    {
      "reunionID": "6f9619ff-8b86-d011-b42d-00cf4fc964ff",
      "field": "sharedGroupDisplayName",
      "value": "東京旅行",
