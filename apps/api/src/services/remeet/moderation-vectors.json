{
  "_readme": [
    "Cross-language fixtures for the moderation digest.",
    "Read by RemeetTests/ModerationTargetTests.swift and by",
    "apps/api/src/services/remeet/moderation-digest.test.ts.",
    "Expected values come from a third, independent implementation, so a shared",
    "mistake in Swift and TypeScript cannot make both suites pass.",
    "If the two shipping implementations ever disagree, the manifest silently",
    "matches nothing and no error is raised anywhere. That is why this exists."
  ],
  "namespace": "remeet.moderation.v1",
  "normalization": [
    {
      "name": "nfkc-fullwidth",
      "input": "Ｈｅｌｌｏ　Ｗｏｒｌｄ",
      "expected": "hello world"
    },
    {
      "name": "nfkc-halfwidth-kana",
      "input": "ﾄｳｷﾗｳ",
      "expected": "トウキラウ"
    },
    {
      "name": "nfkc-combining-dakuten",
      "input": "がわ",
      "expected": "がわ"
    },
    {
      "name": "case",
      "input": "ToKyO Trip",
      "expected": "tokyo trip"
    },
    {
      "name": "surrounding-whitespace",
      "input": "   東京   ",
      "expected": "東京"
    },
    {
      "name": "newlines",
      "input": "東\n京\r\n旅行",
      "expected": "東 京 旅行"
    },
    {
      "name": "zero-width",
      "input": "to​kyo‌tri﻿p",
      "expected": "tokyotrip"
    },
    {
      "name": "soft-hyphen",
      "input": "re­meet",
      "expected": "remeet"
    },
    {
      "name": "variation-selector",
      "input": "❤️ and ❤",
      "expected": "❤ and ❤"
    },
    {
      "name": "zwj-emoji-preserved",
      "input": "👨‍👩‍👧",
      "expected": "👨‍👩‍👧"
    },
    {
      "name": "repeated-spaces",
      "input": "東京    旅行",
      "expected": "東京 旅行"
    },
    {
      "name": "ideographic-space",
      "input": "東京　旅行",
      "expected": "東京 旅行"
    },
    {
      "name": "nbsp",
      "input": "Paris Trip",
      "expected": "paris trip"
    },
    {
      "name": "japanese-plain",
      "input": "来月の再会がたのしみ",
      "expected": "来月の再会がたのしみ"
    },
    {
      "name": "emoji-plain",
      "input": "再会まであと3日 🌍✈️",
      "expected": "再会まであと3日 🌍✈"
    },
    {
      "name": "mixed",
      "input": "  Ｔｏｋｙｏ​　ＴＲＩＰ  ",
      "expected": "tokyo trip"
    },
    {
      "name": "empty",
      "input": "   ",
      "expected": ""
    }
  ],
  "childDigests": [
    {
      "kind": "wish",
      "id": "6f9619ff-8b86-d011-b42d-00cf4fc964ff",
      "expected": "3u_hkg0MR52LbaQ0cD0he6G7jzAgCPvQZSJoVSTdMS8"
    },
    {
      "kind": "wish",
      "id": "6F9619FF-8B86-D011-B42D-00CF4FC964FF",
      "expected": "3u_hkg0MR52LbaQ0cD0he6G7jzAgCPvQZSJoVSTdMS8"
    },
    {
