{
  "name": "@tomokichi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run",
    "check": "wrangler types --env-interface CloudflareBindings --strict-vars=false && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "moderation": "node --experimental-strip-types scripts/moderation.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false"
  },
  "dependencies": {
    "@tomokichi/app-site": "workspace:*",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
