{
  "name": "@tomokichi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf deploy --dry-run",
    "check": "wrangler types --env-interface CloudflareBindings --strict-vars=false && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "cf deploy",
    "moderation": "node --experimental-strip-types scripts/moderation.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false"
  },
  "dependencies": {
    "@inquiry-platform/sdk": "github:tomoki013/inquiry-platform#v0.3.1&path:/packages/sdk",
    "@tomokichi/app-site": "workspace:*",
    "hono": "^4.13.9",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "cf": "1.0.0-beta.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
