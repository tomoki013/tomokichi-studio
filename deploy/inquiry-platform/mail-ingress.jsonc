{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomokichi-mail-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  // Tomokichi's deployment of inquiry-platform's mail Worker (apps/mail-ingress). Paths are relative
  // to apps/mail-ingress/ of the pinned release (deploy/inquiry-platform/run.mjs).
  // postal-mime reaches for a few Node built-ins when parsing MIME.
  "compatibility_flags": ["nodejs_compat"],

  // An Email Worker is addressed by Cloudflare Email Routing, not by a URL.
  // Nothing here should be reachable over HTTP.
  "workers_dev": false,

  "observability": {
    "enabled": true
  },

  "vars": {
    "SUPPORT_EMAIL": "support@tmkch.io",
    // Inbound addresses are project-scoped. The legacy address remains the
    // fallback for Studio mail that has no route entry.
    "APP_MAIL_ROUTES": "[{\"address\":\"support@zakkary.app\",\"projectSlug\":\"zakkary\",\"forwardEmail\":\"zakkary001@gmail.com\"}]",
    // Bytes above this are forwarded but not stored: a 25MB mail parsed into a
    // Worker's memory is a way to make ingestion fail for everybody.
    "MAX_STORED_BYTES": "5242880"
  },

  "services": [
    {
      // Raw-mail recovery uses Core's existing private bucket; no D1 binding.
      "binding": "ADMIN_CORE",
      "service": "tomokichi-admin-core",
      "entrypoint": "AdminCore"
    }
  ],
  "r2_buckets": [{ "binding": "PRIVATE_FILES", "bucket_name": "tomokichi-admin-files" }]

  // SUPPORT_FORWARD_EMAIL is a Secret, not a var: it is the operator's personal
  // address and does not belong in git. Set with:
  //   wrangler secret put SUPPORT_FORWARD_EMAIL
}
